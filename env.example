# =============================================================================
# tenderpreneurs.co.za — environment variables
# Copy to .env (or set in Coolify) and fill in real values.
# =============================================================================

# ---------- Runtime ----------
NODE_ENV=production
PORT=3000
APP_URL=https://tenderpreneurs.co.za
API_URL=https://api.tenderpreneurs.co.za

# ---------- Postgres ----------
# Hetzner / Coolify-managed Postgres connection string.
DATABASE_URL=postgres://tenderpreneurs:CHANGE_ME@db:5432/tenderpreneurs
DB_POOL_MAX=10
# Set to "false" if your DB does not require SSL (e.g. local docker network).
DB_SSL=false

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- JWT ----------
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_min_64_chars_random_string
JWT_REFRESH_SECRET=CHANGE_ME_min_64_chars_random_string

# ---------- Cookies ----------
# Set to ".tenderpreneurs.co.za" if API and web share the apex.
# Leave blank in dev.
COOKIE_DOMAIN=.tenderpreneurs.co.za

# ---------- CORS ----------
# Comma-separated list of allowed origins.
CORS_ORIGINS=https://tenderpreneurs.co.za,https://www.tenderpreneurs.co.za

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MIN=120

# ---------- Email (Resend) ----------
# https://resend.com/api-keys
RESEND_API_KEY=re_CHANGE_ME
MAIL_FROM="Tenderpreneurs <no-reply@tenderpreneurs.co.za>"

# ---------- AI providers (used by ai_usage_log features) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---------- Payments (PayFast — South African gateway) ----------
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=live

# ---------- Logging / observability ----------
LOG_LEVEL=info
SENTRY_DSN=
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886