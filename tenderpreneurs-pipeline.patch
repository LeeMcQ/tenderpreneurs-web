+---
+import BaseLayout from "../../layouts/BaseLayout.astro";
+
+const reason = Astro.url.searchParams.get("reason") || "unknown";
+
+const messages: Record<string, { heading: string; body: string }> = {
+  invalid_token:  { heading: "That link wasn't valid.",         body: "The token looked malformed. Request a fresh sign-in link." },
+  not_found:      { heading: "We don't recognise that link.",    body: "It may have been mistyped or already used. Request a fresh one." },
+  already_used:   { heading: "That link's already been used.",   body: "Sign-in links work once. Request a new one to sign in again." },
+  expired:        { heading: "That link has expired.",           body: "Sign-in links last 15 minutes. Request a fresh one." },
+  unknown:        { heading: "Something went wrong.",            body: "We weren't able to sign you in. Try requesting a new link." },
+};
+const m = messages[reason] || messages.unknown;
+---
+
+<BaseLayout title={`Sign-in error — ${m.heading}`} description="There was a problem signing you in.">
+  <article class="container mx-auto px-4 py-16 max-w-md text-center">
+    <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-rose-100">
