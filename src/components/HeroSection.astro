---
export interface Props {
  headline?: string;
  subheadline?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  badge?: string;
}

const {
  headline = 'Win More Government Tenders',
  subheadline = 'Tenderpreneurs uses AI to help South African SMMEs navigate PFMA procurement, track opportunities, and submit winning bids.',
  ctaLabel = 'Get Started Free',
  ctaHref = 'https://app.tenderpreneurs.co.za',
  secondaryLabel = 'Explore PFMA Guide',
  secondaryHref = '/pfma',
  badge = '🇿🇦 Built for SA SMMEs',
} = Astro.props;
---

<section class="hero" aria-label="Hero">
  <!-- Background decoration -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid-pattern"></div>
    <div class="hero-blob-1"></div>
    <div class="hero-blob-2"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      {badge && (
        <div class="hero-badge animate-fade-in">
          <span>{badge}</span>
          <span class="hero-badge-sep" aria-hidden="true">·</span>
          <span class="hero-badge-live">
            <span class="live-dot" aria-hidden="true"></span>
            Live tender data
          </span>
        </div>
      )}

      <h1 class="hero-headline animate-fade-up" style="animation-delay: 0.1s;">
        {headline}
        <em class="hero-headline-em">with AI Intelligence</em>
      </h1>

      <p class="hero-subheadline animate-fade-up" style="animation-delay: 0.2s;">
        {subheadline}
      </p>

      <div class="hero-actions animate-fade-up" style="animation-delay: 0.3s;">
        <a href={ctaHref} class="btn btn-primary hero-cta-primary" rel="noopener">
          {ctaLabel}
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M3.75 9h10.5M9.75 4.5l4.5 4.5-4.5 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={secondaryHref} class="btn btn-ghost hero-cta-secondary">
          {secondaryLabel}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Trust signals -->
      <div class="hero-trust animate-fade-up" style="animation-delay: 0.4s;">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13.5 4.5l-7 7L3 8" stroke="#D97706" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Free to start</span>
        </div>
        <div class="trust-sep" aria-hidden="true">·</div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13.5 4.5l-7 7L3 8" stroke="#D97706" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>No credit card required</span>
        </div>
        <div class="trust-sep" aria-hidden="true">·</div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13.5 4.5l-7 7L3 8" stroke="#D97706" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>POPIA compliant</span>
        </div>
      </div>
    </div>

    <!-- Hero stats / visual -->
    <div class="hero-stats animate-fade-up" style="animation-delay: 0.35s;" aria-label="Platform statistics">
      <div class="stats-card">
        <div class="stats-header">
          <div class="stats-header-dot" aria-hidden="true"></div>
          <span class="stats-header-text">Live Tender Feed</span>
        </div>
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-number">7,841<span class="stat-plus">+</span></span>
            <span class="stat-label">Open Tenders</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">9</span>
            <span class="stat-label">Provinces</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">4hr</span>
            <span class="stat-label">Update Cycle</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">R2.4B<span class="stat-plus">+</span></span>
            <span class="stat-label">Tender Value</span>
          </div>
        </div>
        <div class="stats-sample">
          <div class="sample-tender">
            <span class="sample-tender-dot" aria-hidden="true"></span>
            <div>
              <div class="sample-tender-title">Supply of PPE Equipment — KZN DoH</div>
              <div class="sample-tender-meta">R500K–R2M · Closes in 14 days · KwaZulu-Natal</div>
            </div>
            <span class="sample-tender-score" aria-label="Win probability 78%">78%</span>
          </div>
          <div class="sample-tender">
            <span class="sample-tender-dot sample-tender-dot--orange" aria-hidden="true"></span>
            <div>
              <div class="sample-tender-title">IT Infrastructure Refresh — SARS</div>
              <div class="sample-tender-meta">R1M–R5M · Closes in 7 days · National</div>
            </div>
            <span class="sample-tender-score" aria-label="Win probability 61%">61%</span>
          </div>
          <div class="sample-tender">
            <span class="sample-tender-dot sample-tender-dot--red" aria-hidden="true"></span>
            <div>
              <div class="sample-tender-title">Construction: RDP Housing — GP DHS</div>
              <div class="sample-tender-meta">R10M+ · Closes in 3 days · Gauteng</div>
            </div>
            <span class="sample-tender-score" aria-label="Win probability 43%">43%</span>
          </div>
        </div>
        <div class="stats-footer">
          <span>Powered by etenders.gov.za + AI scoring</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #0C1B33 0%, #112043 40%, #1B4F8A 100%);
    padding: 4rem 0 5rem;
    color: white;
  }

  @media (min-width: 768px) {
    .hero { padding: 7rem 0 8rem; }
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 420px;
    }
  }

  .hero-content { order: 1; }
  .hero-stats { order: 2; }

  .hero-headline {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    font-weight: 900;
  }

  .hero-headline-em {
    display: block;
    color: #E88A1C;
    font-style: italic;
  }

  /* Stats card – more “dashboard” feel */
  .stats-card {
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 1.5rem;
    padding: 1.5rem;
  }

  .dark .stats-card { /* already good */ }
</style>
