---
/**
 * CtaBanner.astro
 * src/components/CtaBanner.astro
 *
 * Reusable CTA banner used at the bottom of most pages.
 *
 * Props:
 *   eyebrow      — small label above heading
 *   heading      — main heading (HTML allowed for <span class="txt-gold">)
 *   body         — paragraph text
 *   primaryLabel — primary CTA button text
 *   primaryHref  — primary CTA URL
 *   secondLabel  — secondary ghost button text (optional)
 *   secondHref   — secondary ghost button URL (optional)
 */

interface Props {
  eyebrow?:     string;
  heading:      string;
  body:         string;
  primaryLabel: string;
  primaryHref:  string;
  secondLabel?: string;
  secondHref?:  string;
}

const {
  eyebrow      = 'Get started today',
  heading,
  body,
  primaryLabel,
  primaryHref,
  secondLabel,
  secondHref,
} = Astro.props;
---

<div class="cta-banner wrap">
  <div class="cta-inner">
    <div class="eyebrow eyebrow-center">{eyebrow}</div>
    <h2 set:html={heading}></h2>
    <p class="txt-secondary">{body}</p>
    <div class="cta-actions">
      <a href={primaryHref} class="btn btn-gold btn-lg">
        {primaryLabel}
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>
      {secondLabel && secondHref && (
        <a href={secondHref} class="btn btn-ghost btn-lg">{secondLabel}</a>
      )}
    </div>
  </div>
</div>

<style>
.cta-banner {
  padding: var(--sp-16) 0 var(--sp-4);
}

.cta-inner {
  background:    linear-gradient(135deg, var(--srf-1), var(--srf-2));
  border:        1px solid var(--brd);
  border-radius: var(--r-xl);
  padding:       var(--sp-12) var(--sp-6);
  text-align:    center;
  position:      relative;
  overflow:      hidden;
}
@media (min-width: 768px) {
  .cta-inner { padding: var(--sp-16) var(--sp-12); }
}

/* Radial gold glow */
.cta-inner::before {
  content:         '';
  position:        absolute;
  top:    50%;
  left:   50%;
  transform:       translate(-50%, -50%);
  width:           500px;
  height:          250px;
  background:      radial-gradient(ellipse, rgba(245,166,35,.08), transparent 70%);
  pointer-events:  none;
}

.cta-inner h2 { margin-bottom: var(--sp-3); }

.cta-inner p {
  font-size:    1rem;
  max-width:    460px;
  margin:       0 auto var(--sp-8);
  line-height:  1.7;
}

.cta-actions {
  display:         flex;
  justify-content: center;
  flex-wrap:       wrap;
  gap:             var(--sp-3);
}
</style>
