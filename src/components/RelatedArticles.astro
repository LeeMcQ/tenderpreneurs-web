---
import { getCollection } from 'astro:content';
import { format } from 'date-fns';

export interface Props {
  tags: string[];
}

const { tags } = Astro.props;

// Option 1: fetch all blog posts and filter by common tags
const allPosts = await getCollection('blog');

const related = allPosts
  .filter((p) => p.data.tags && p.data.tags.some((tag: string) => tags.includes(tag)))
  .slice(0, 3); // take top 3 (most recent first – assuming ordered by date)

// If not enough related posts, fallback to most recent posts
const fallbackPosts = allPosts.slice(0, 3);
const postsToShow = related.length >= 1 ? related : fallbackPosts;
---

<div class="mt-12">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Related Articles</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {postsToShow.map((post) => (
      <a
        href={`/blog/${post.slug}`}
        class="block bg-white rounded-xl shadow hover:shadow-md p-5 border border-gray-100 transition"
      >
        <span class="text-xs text-gray-400">
          {format(post.data.date, 'd MMM yyyy')}
        </span>
        <h3 class="font-semibold text-gray-900 mt-1 mb-1">
          {post.data.title}
        </h3>
        <p class="text-sm text-gray-600 line-clamp-2">
          {post.data.description}
        </p>
      </a>
    ))}
  </div>
</div>