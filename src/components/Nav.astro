/**
 * Nav.astro — Find tenders is discovery only.
 * Tender creation assistant is the buyer path.
 */
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="Tenderpreneurs home">
      <div class="logo-mark" aria-hidden="true">TP</div>
      <span class="logo-name">
        Tenderpreneurs<span class="logo-tld">.co.za</span>
      </span>
    </a>

    <ul class="nav-links list-none" role="list">
      <li><a href="/tenders">Find tenders</a></li>
      <li><a href="/assistant">Tender creation assistant</a></li>
      <li><a href="/pfma">PFMA Guide</a></li>
      <li><a href="/pricing">Pricing</a></li>
    </ul>

    <div class="nav-right">
      <a href="/auth/login" class="btn btn-gold nav-cta" aria-label="Get started free">
        Get Started Free
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>
      <button class="hamburger" id="tp-ham" aria-label="Open menu" aria-expanded="false" aria-controls="tp-drawer">
