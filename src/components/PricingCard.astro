---
/**
 * PricingCard.astro
 * src/components/PricingCard.astro
 *
 * Props:
 *   plan       — plan name ('Free' | 'Professional' | 'Enterprise')
 *   price      — price string e.g. 'R0', 'R299', 'Custom'
 *   period     — billing period string e.g. 'forever free', 'per month'
 *   features   — string[] list of included features
 *   ctaLabel   — button text
 *   ctaHref    — button href
 *   ctaVariant — 'ghost' | 'teal' | 'gold' (default: 'ghost')
 *   featured   — boolean, adds teal highlight border + badge
 *   badge      — badge text shown above card when featured=true
 */

interface Props {
  plan:        string;
  price:       string;
  period:      string;
  features:    string[];
  ctaLabel:    string;
  ctaHref:     string;
  ctaVariant?: 'ghost' | 'teal' | 'gold';
  featured?:   boolean;
  badge?:      string;
}

const {
  plan,
  price,
  period,
  features,
  ctaLabel,
  ctaHref,
  ctaVariant = 'ghost',
  featured   = false,
  badge      = 'Most Popular',
} = Astro.props;
---

<div class={`price-card card${featured ? ' card-teal' : ''}`}>
  {featured && <span class="price-badge">{badge}</span>}

  <div class="price-plan-name">{plan}</div>

  <div class={`price-amount${price.length > 4 ? ' price-amount--sm' : ''}`}>
    {price}
  </div>
  <div class="price-period txt-secondary text-xs">{period}</div>

  <ul class="price-features list-none" aria-label={`${plan} plan features`}>
    {features.map(f => (
      <li class="price-feat text-sm txt-secondary">
        <span class="price-feat-icon" aria-hidden="true">✓</span>
        {f}
      </li>
    ))}
  </ul>

  <a href={ctaHref} class={`btn btn-${ctaVariant} btn-full`}>
    {ctaLabel}
  </a>
</div>

<style>
.price-card {
  position:      relative;
  padding:       var(--sp-6);
  transition:    transform 0.2s ease, border-color 0.2s ease;
}
.price-card:hover { transform: translateY(-2px); }

.price-badge {
  position:      absolute;
  top:           -13px;
  left:          50%;
  transform:     translateX(-50%);
  background:    var(--clr-teal);
  color:         var(--txt-inverse);
  font-size:     11px;
  font-weight:   700;
  padding:       3px 14px;
  border-radius: var(--r-full);
  white-space:   nowrap;
  letter-spacing: 0.02em;
}

.price-plan-name {
  font-size:      0.8125rem;
  font-weight:    700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color:          var(--txt-secondary);
  margin-bottom:  var(--sp-2);
}

.price-amount {
  font-family:    var(--font-mono);
  font-size:      2.5rem;
  font-weight:    500;
  letter-spacing: -0.04em;
  line-height:    1;
  margin-bottom:  4px;
}
.price-amount--sm { font-size: 1.5rem; padding-top: 6px; }

.price-period { margin-bottom: var(--sp-5); }

.price-features {
  display:        flex;
  flex-direction: column;
  gap:            var(--sp-2);
  margin-bottom:  var(--sp-6);
}

.price-feat {
  display:     flex;
  align-items: flex-start;
  gap:         var(--sp-2);
  line-height: 1.5;
}

.price-feat-icon {
  flex-shrink:     0;
  width:           16px;
  height:          16px;
  margin-top:      2px;
  background:      var(--clr-teal-muted);
  border-radius:   50%;
  display:         flex;
  align-items:     center;
  justify-content: center;
  font-size:       9px;
  color:           var(--clr-teal);
}
</style>
