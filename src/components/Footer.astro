---
/**
 * Footer.astro
 *
 * Fix: Removed `CTA.features` and `CTA.scoring` references — CTA was never
 * defined or imported. Replaced with hardcoded hrefs.
 */
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50 text-slate-700">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2">
        <a href="/" class="inline-flex items-center gap-2">
          <span class="text-base font-semibold text-slate-900">Tenderpreneurs</span>
        </a>
        <p class="mt-3 max-w-sm text-sm text-slate-600">
          AI-powered government tender intelligence for South African SMMEs.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Product</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="hover:text-slate-900" href="/">Home</a></li>
          <li><a class="hover:text-slate-900" href="/pricing">Pricing</a></li>
          <li><a class="hover:text-slate-900" href="/about">About</a></li>
          <li><a class="hover:text-slate-900" href="/blog">Blog</a></li>
          <li><a class="hover:text-slate-900" href="/#features">Features</a></li>
          <li><a class="hover:text-slate-900" href="/tenders">Win Probability AI</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Legal</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a class="hover:text-slate-900" href="/privacy" data-testid="footer-privacy-link">
              Privacy Policy
            </a>
          </li>
          <li>
            <a class="hover:text-slate-900" href="/terms" data-testid="footer-terms-link">
              Terms of Service
            </a>
          </li>
          <li>
            <a class="hover:text-slate-900" href="/cookies" data-testid="footer-cookies-link">
              Cookies Policy
            </a>
          </li>
          <li>
            <button
              type="button"
              data-testid="footer-cookie-settings"
              class="text-left underline decoration-slate-400 underline-offset-2 hover:text-slate-900"
              onclick="if (window.tpConsent) { window.tpConsent.open(); }"
            >
              Cookie settings
            </button>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Tenderpreneurs (Pty) Ltd. All rights reserved.</p>
      <p>Registered in South Africa. POPIA Information Officer: <a class="underline" href="mailto:privacy@tenderpreneurs.co.za">privacy@tenderpreneurs.co.za</a></p>
    </div>
  </div>
</footer>
