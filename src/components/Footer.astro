---
/**
 * Footer.astro
 * src/components/Footer.astro
 */

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">

    <div class="footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="Tenderpreneurs home">
          <div class="logo-mark" aria-hidden="true">TP</div>
          <span class="logo-name">Tenderpreneurs</span>
        </a>
        <p class="text-sm txt-secondary mt-3">
          AI-powered government tender intelligence for South African SMMEs.
          Navigate procurement. Win more bids.
        </p>
        <div class="footer-popia">🇿🇦 Registered in SA · POPIA Compliant</div>
      </div>

      <!-- Platform -->
      <div class="footer-col">
        <h4>Platform</h4>
        <ul class="list-none">
          <li><a href="/tenders">Browse Tenders</a></li>
          <li><a href="/#features">Win Probability AI</a></li>
          <li><a href="/pfma">PFMA Assistant</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>

      <!-- Learn -->
      <div class="footer-col">
        <h4>Learn</h4>
        <ul class="list-none">
          <li><a href="/pfma">PFMA Guide</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/blog/central-supplier-database-registration">CSD Registration</a></li>
          <li><a href="/pfma/b-bbee">B-BBEE Explained</a></li>
          <li><a href="/blog/how-to-win-your-first-government-tender">Win Your First Tender</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div class="footer-col">
        <h4>Legal</h4>
        <ul class="list-none">
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="/cookies">Cookies Policy</a></li>
          <li><a href="mailto:hello@tenderpreneurs.co.za">Contact Us</a></li>
        </ul>
      </div>

    </div><!-- /footer-grid -->

    <div class="footer-bottom">
      <span>
        © {year} Tenderpreneurs (Pty) Ltd. All rights reserved.
        An independent service — not affiliated with or endorsed by the National Treasury or any government department. Tender data is sourced from public portals including eTenders.
      </span>
      <span>
        POPIA Officer:
        <a href="mailto:privacy@tenderpreneurs.co.za">privacy@tenderpreneurs.co.za</a>
      </span>
    </div>

  </div><!-- /wrap -->
</footer>

<style>
.footer {
  background:   var(--srf-1);
  border-top:   1px solid var(--brd);
  padding:      var(--sp-12) 0 calc(var(--sp-8) + var(--safe-b));
}

.footer-grid {
  display:               grid;
  grid-template-columns: 1fr 1fr;
  gap:                   var(--sp-8);
  margin-bottom:         var(--sp-10);
}
@media (min-width: 1024px) {
  .footer-grid {
    grid-template-columns: 260px 1fr 1fr 1fr;
    gap:                   var(--sp-12);
  }
}

.footer-brand { grid-column: 1 / -1; }
@media (min-width: 1024px) { .footer-brand { grid-column: auto; } }

.footer-popia {
  display:       inline-flex;
  align-items:   center;
  gap:           var(--sp-2);
  margin-top:    var(--sp-3);
  background:    rgba(255,255,255,.04);
  border:        1px solid var(--brd);
  border-radius: var(--r-full);
  padding:       4px 12px;
  font-family:   var(--font-mono);
  font-size:     10px;
  color:         var(--txt-tertiary);
}

.footer-col h4 {
  font-size:     0.8125rem;
  font-weight:   700;
  color:         var(--txt-primary);
  margin-bottom: var(--sp-4);
}

.footer-col a {
  display:     flex;
  align-items: center;
  min-height:  var(--touch);
  font-size:   0.8125rem;
  color:       var(--txt-secondary);
  transition:  color 0.15s;
}
.footer-col a:hover { color: var(--txt-primary); }

.footer-bottom {
  border-top:     1px solid var(--brd);
  padding-top:    var(--sp-6);
  display:        flex;
  flex-direction: column;
  gap:            var(--sp-2);
  font-size:      0.75rem;
  color:          var(--txt-tertiary);
}
@media (min-width: 640px) {
  .footer-bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items:    center;
  }
}
.footer-bottom a { color: var(--clr-teal); }
</style>
