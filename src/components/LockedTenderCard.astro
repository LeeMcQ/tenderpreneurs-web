---
// Decorative blurred placeholder card. Stacked behind the SignupGate so users
// see "there's a real feed under here". Renders as static markup — no client JS.
export interface Props {
  /** Render N stacked blurred cards behind the gate */
  count?: number;
}
const { count = 3 } = Astro.props;
const items = Array.from({ length: count }, (_, i) => i);
---

<div aria-hidden="true" class="locked-stack relative mt-4 space-y-3">
  {items.map((i) => (
    <div
      class="rounded-lg border border-slate-200 bg-white p-5 select-none"
      style={`filter: blur(4px); opacity: ${0.7 - i * 0.15};`}
    >
      <div class="h-3 w-24 bg-slate-200 rounded mb-3"></div>
      <div class="h-4 w-3/4 bg-slate-300 rounded mb-2"></div>
      <div class="h-3 w-1/2 bg-slate-200 rounded mb-4"></div>
      <div class="flex gap-2">
        <div class="h-5 w-16 bg-slate-100 rounded-full"></div>
        <div class="h-5 w-20 bg-slate-100 rounded-full"></div>
      </div>
    </div>
  ))}
</div>
