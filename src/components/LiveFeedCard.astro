---
interface Tender {
  name: string;
  meta: string;
  days: number;
}
interface Props {
  tenders?: Tender[];
}
const { tenders = [
  { name: 'PPE Equipment — KZN Dept. of Health',  meta: 'R500K–R2M · KwaZulu-Natal', days: 14 },
  { name: 'IT Infrastructure Refresh — SARS',     meta: 'R1M–R5M · National',         days: 7 },
  { name: 'RDP Housing Construction — GP DHS',    meta: 'R10M+ · Gauteng',             days: 3 },
] } = Astro.props;
---
<div class="feed-card" role="complementary" aria-label="Live tender feed">
  <div class="feed-head">
    <span class="feed-title">Live Tender Feed</span>
    <span class="live-badge" aria-label="Live data">LIVE</span>
  </div>
  <div class="feed-stats" role="list" aria-label="Platform statistics">
    <div class="stat-box" role="listitem"><div class="stat-val">60+</div><div class="stat-lab">Open Tenders</div></div>
    <div class="stat-box" role="listitem"><div class="stat-val">R2.4B+</div><div class="stat-lab">Total Value</div></div>
    <div class="stat-box" role="listitem"><div class="stat-val">9</div><div class="stat-lab">Provinces</div></div>
    <div class="stat-box" role="listitem"><div class="stat-val">4hr</div><div class="stat-lab">Refresh</div></div>
  </div>
  <ul class="tender-list list-none" aria-label="Sample tenders">
    {tenders.map(t => (
      <li class="tender-row">
        <div class="tr-info">
          <div class="tr-name">{t.name}</div>
          <div class="tr-meta mono">{t.meta}</div>
        </div>
        <div class="tr-score" aria-label={`${t.days} days left`}>
          <span class="score-pct mono">{t.days}d</span>
        </div>
      </li>
    ))}
  </ul>
  <p class="feed-foot mono">Powered by etenders.gov.za · go / no-go gates, not a score</p>
</div>
<style>
.feed-card {
  background: var(--srf-1);
  border: 1px solid var(--brd-2);
  border-radius: var(--r-xl);
  padding: var(--sp-5);
  position: relative;
  overflow: hidden;
}
.feed-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--clr-teal), var(--clr-gold));
}
.feed-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-4); }
.feed-title { font-size: 0.9375rem; font-weight: 600; }
.feed-stats { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2); margin-bottom: var(--sp-3); }
.tender-list { display: flex; flex-direction: column; gap: var(--sp-2); }
.tender-row {
  background: rgba(255,255,255,.03);
  border: 1px solid var(--brd);
  border-radius: var(--r-sm);
  padding: var(--sp-3);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--sp-3);
}
.tr-info { flex: 1; min-width: 0; }
.tr-name { font-size: 0.8125rem; font-weight: 600; line-height: 1.3; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tr-meta { font-size: 10px; color: var(--txt-tertiary); }
.tr-score { flex-shrink: 0; text-align: right; }
.score-pct { display: block; font-size: 0.75rem; font-weight: 500; color: var(--clr-gold); }
.feed-foot { font-size: 10px; color: var(--txt-tertiary); text-align: center; margin-top: var(--sp-3); }
</style>
