---
interface Tender {
  title: string;
  entity: string;
  province: string;
  sector: string;
  value: string;
  closing_date: string;
  status: string;
}

interface Props {
  tender: Tender;
}

const { tender } = Astro.props;
---

<div class="border border-gray-200 rounded-lg p-4 bg-white shadow-sm hover:shadow-md transition-shadow">
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-navy-900 text-sm leading-snug">{tender.title}</h3>
    <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700">
      {tender.status}
    </span>
  </div>
  <p class="mt-1 text-xs text-gray-500">{tender.entity}</p>
  <div class="mt-3 flex flex-wrap gap-2 text-xs text-gray-600">
    <span>📍 {tender.province}</span>
    <span>🏷️ {tender.sector}</span>
    <span>💰 {tender.value}</span>
    <span>⏰ Closes: {tender.closing_date}</span>
  </div>
</div>