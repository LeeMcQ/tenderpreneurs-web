---
interface Props {
  title: string;
  entity: string;
  province: string;
  sector: string;
  value: string;
  closing_date: string;
  status: string;
}

const { title, entity, province, sector, value, closing_date, status } = Astro.props;
---

<div class="card border border-gray-200 rounded-lg p-4 bg-white dark:bg-navy-900 dark:border-navy-700">
  <div class="flex items-start justify-between gap-2">
    <h3 class="font-semibold text-navy-900 dark:text-white text-sm leading-snug">{title}</h3>
    <span class="shrink-0 text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700">
      {status}
    </span>
  </div>
  <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">{entity}</p>
  <div class="mt-3 flex flex-wrap gap-2 text-xs text-gray-600 dark:text-gray-300">
    <span>📍 {province}</span>
    <span>🏷️ {sector}</span>
    <span>💰 {value}</span>
    <span>⏰ Closes: {closing_date}</span>
  </div>
</div>