---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';

// Province + sector data is now centralised so we can render
// the homepage tiles AND keep the JSON-LD/sitemap in sync later.
const provinces = [
  { name: 'Eastern Cape',   slug: 'eastern-cape' },
  { name: 'Free State',     slug: 'free-state' },
  { name: 'Gauteng',        slug: 'gauteng' },
  { name: 'KwaZulu-Natal',  slug: 'kwazulu-natal' },
  { name: 'Limpopo',        slug: 'limpopo' },
  { name: 'Mpumalanga',     slug: 'mpumalanga' },
  { name: 'Northern Cape',  slug: 'northern-cape' },
  { name: 'North West',     slug: 'north-west' },
  { name: 'Western Cape',   slug: 'western-cape' },
];

const sectors = [
  { name: 'Construction', slug: 'construction', icon: '🏗️' },
  { name: 'ICT',          slug: 'ict',          icon: '💻' },
  { name: 'Health',       slug: 'health',       icon: '🩺' },
  { name: 'Education',    slug: 'education',    icon: '🎓' },
  { name: 'Transport',    slug: 'transport',    icon: '🚚' },
  { name: 'Agriculture',  slug: 'agriculture',  icon: '🌾' },
  { name: 'Energy',       slug: 'energy',       icon: '⚡' },
  { name: 'Security',     slug: 'security',     icon: '🛡️' },
  { name: 'Consulting',   slug: 'consulting',   icon: '📋' },
  { name: 'Cleaning',     slug: 'cleaning',     icon: '🧹' },
  { name: 'Catering',     slug: 'catering',     icon: '🍽️' },
  { name: 'Legal',        slug: 'legal',        icon: '⚖️' },
];

const featuredPosts = [
  {
    slug: 'how-to-win-your-first-government-tender',
    title: 'How to Win Your First Government Tender in South Africa',
    excerpt: 'A step-by-step guide for newcomers, covering everything from finding the right opportunities to submitting a compliant bid.',
    readingTime: '8 min read',
    category: 'Beginners',
  },
  {
    slug: 'understanding-bbbee-requirements',
    title: 'Understanding B-BBEE Requirements for Tenders',
    excerpt: 'Learn how your B-BBEE scorecard affects your tender competitiveness and what documentation you need to submit.',
    readingTime: '6 min read',
    category: 'Compliance',
  },
  {
    slug: 'central-supplier-database-registration',
    title: 'Central Supplier Database Registration: A Complete Walkthrough',
    excerpt: 'Everything you need to know to register on the CSD, from required documents to avoiding common mistakes.',
    readingTime: '10 min read',
    category: 'Compliance',
  },
];

const faqs = [
  {
    q: 'How do I find government tenders in South Africa?',
    a: 'Government tenders are published on the eTender Publication Portal, departmental websites, and various tender notice boards. You can also use aggregated platforms like Tenderpreneur to monitor opportunities across all provinces and sectors.',
  },
  {
    q: 'What is eTenders and how does it work?',
    a: 'eTenders is the South African government\u2019s official electronic tender portal where public sector contracts are advertised. Suppliers can search for tenders, download bid documents, and sometimes submit bids online.',
  },
  {
    q: 'How do I register on the Central Supplier Database?',
    a: 'Visit the CSD website, complete the online registration form, upload the required supporting documents (such as tax clearance certificate, B-BBEE certificate, and bank confirmation letter), and submit for verification.',
  },
  {
    q: 'What is PFMA compliance?',
    a: 'PFMA stands for the Public Finance Management Act. It sets out the financial management and procurement rules that government entities must follow to ensure transparency, fairness, and value for money in tender processes.',
  },
  {
    q: 'How are B-BBEE points calculated for tenders?',
    a: 'B-BBEE points are awarded based on your verified scorecard. Typically, 10 or 20 points are allocated to B-BBEE status level in the total tender evaluation, with higher levels earning more points. The exact calculation depends on the specific tender\u2019s Preferential Procurement regulations.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="Tenderpreneur — Win More South African Government Tenders"
  description="Browse 7,841+ live SA government tenders, score your win probability with AI, and get instant PFMA, PPPFA and B-BBEE answers. Built for South African SMMEs."
  schema={faqSchema}
>
  <!-- 1. Hero (lives in the component, includes its own scoped CSS) -->
  <HeroSection />

  <!-- 2. Feature grid: Tenders / AI score / PFMA assistant -->
  <FeatureGrid />

  <!-- 3. Province grid -->
  <section class="section bg-[var(--color-surface)]" id="provinces" aria-labelledby="provinces-heading">
    <div class="container">
      <div class="text-center mb-10">
        <span class="eyebrow">By Province</span>
        <h2 id="provinces-heading" class="text-3xl md:text-4xl font-bold text-balance">
          Browse tenders <span class="text-gradient-civic">across all 9 provinces</span>
        </h2>
        <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl mx-auto">
          From the Western Cape to Limpopo — every open opportunity, refreshed every 4 hours.
        </p>
      </div>

      <ul role="list" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
  {sectors.map((s) => (
    <li key={s.slug}>
      <a href={`/tenders/${s.slug}`} class="tile group">
        <span class="text-4xl">{s.icon}</span>
        <span class="tile-title">{s.name}</span>
        <svg class="tile-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 10h10m-4-4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </li>
  ))}
</ul>
    </div>
  </section>

  <!-- 4. Sector grid -->
  <section class="section bg-[var(--color-surface-2)]" id="sectors" aria-labelledby="sectors-heading">
    <div class="container">
      <div class="text-center mb-10">
        <span class="eyebrow">By Sector</span>
        <h2 id="sectors-heading" class="text-3xl md:text-4xl font-bold text-balance">
          Find tenders in <span class="text-gradient-gold">your industry</span>
        </h2>
        <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl mx-auto">
          Twelve sectors covered, with filters for value, B-BBEE level and closing date inside each.
        </p>
      </div>

      <ul role="list" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
        {sectors.map((s) => (
          <li>
            <a href={`/tenders/${s.slug}`} class="tile" aria-label={`Browse ${s.name} tenders`}>
              <span class="flex items-center gap-3">
                <span class="text-xl" aria-hidden="true">{s.icon}</span>
                <span class="tile-title">{s.name}</span>
              </span>
              <svg class="tile-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 10h10m-4-4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Featured blog posts -->
  <section class="section bg-[var(--color-surface)]" id="resources" aria-labelledby="resources-heading">
    <div class="container">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
          <span class="eyebrow">Resources</span>
          <h2 id="resources-heading" class="text-3xl md:text-4xl font-bold text-balance">
            Procurement guides &amp; insights
          </h2>
          <p class="mt-3 text-[var(--color-text-muted)] max-w-2xl">
            Expert advice for winning more government contracts.
          </p>
        </div>
        <a href="/blog" class="btn-ghost">
          View all articles
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {featuredPosts.map((post) => (
          <article class="card overflow-hidden flex flex-col">
            <div class="gradient-sky h-32 flex items-end p-4">
              <span class="badge-civic">{post.category}</span>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl font-bold mb-2 leading-snug">
                <a href={`/blog/${post.slug}`} class="hover:text-[var(--color-civic)] transition-colors">
                  {post.title}
                </a>
              </h3>
              <p class="text-[var(--color-text-muted)] line-clamp-3 mb-4">{post.excerpt}</p>
              <div class="mt-auto flex items-center justify-between text-sm">
                <span class="text-[var(--color-text-muted)]">{post.readingTime}</span>
                <a
                  href={`/blog/${post.slug}`}
                  class="text-[var(--color-civic)] font-semibold hover:underline"
                  aria-label={`Read: ${post.title}`}
                >
                  Read more →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="section bg-[var(--color-surface-2)]" id="faq" aria-labelledby="faq-heading">
    <div class="container max-w-4xl">
      <div class="text-center mb-10">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-heading" class="text-3xl md:text-4xl font-bold text-balance">
          Frequently asked questions
        </h2>
        <p class="mt-3 text-[var(--color-text-muted)]">
          Short answers to the questions South African suppliers ask us most.
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((item) => (
          <details class="card group p-0 overflow-hidden">
            <summary class="flex justify-between items-center gap-4 font-semibold p-5 cursor-pointer list-none text-[var(--color-navy)] dark:text-white">
              <span>{item.q}</span>
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[var(--color-sky)] dark:bg-slate-800 flex items-center justify-center transition-transform duration-200 group-open:rotate-180">
                <svg class="w-4 h-4 text-[var(--color-civic)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5 text-[var(--color-text-muted)] dark:text-slate-300 leading-relaxed">
              {item.a}
            </div>
          </details>
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-[var(--color-text-muted)] mb-4">Still have questions?</p>
        <a href="/pfma" class="btn-secondary">
          Ask the PFMA Assistant
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
