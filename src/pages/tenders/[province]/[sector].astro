---
import type { GetStaticPaths } from 'astro';
import tenders from '../../../data/tenders-seed.json';
import TenderCard from '../../../components/TenderCard.astro';

interface Tender {
  title: string;
  province: string;
  sector: string;
  closingDate: string;
  description: string;
  link?: string;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const combinations = [...new Set(tenders.map((t: Tender) => `${t.province}|${t.sector}`))];
  return combinations.map((combo) => {
    const [province, sector] = combo.split('|');
    return { params: { province, sector } };
  });
};

const { province, sector } = Astro.params;
if (!province || !sector) return Astro.redirect('/tenders');

const filtered = (tenders as Tender[]).filter(
  (t) =>
    t.province.toLowerCase() === province.toLowerCase() &&
    t.sector.toLowerCase() === sector.toLowerCase()
);

const provinceName = province.charAt(0).toUpperCase() + province.slice(1);
const sectorName = sector.charAt(0).toUpperCase() + sector.slice(1);

const metaTitle = `${sectorName} Tenders in ${provinceName} – tenderpreneurs`;
const metaDescription = `Find the latest ${sectorName} government tenders and RFQs in ${provinceName}. Instant alerts for new opportunities.`;

const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tenderpreneurs.co.za/' },
    { '@type': 'ListItem', position: 2, name: 'Tenders', item: 'https://tenderpreneurs.co.za/tenders' },
    { '@type': 'ListItem', position: 3, name: `${provinceName}`, item: `https://tenderpreneurs.co.za/tenders/${province}` },
    { '@type': 'ListItem', position: 4, name: `${sectorName} in ${provinceName}`, item: Astro.url.href },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: filtered.slice(0, 10).map((t, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `https://tenderpreneurs.co.za/tenders/${t.province}/${t.sector}/${t.title.toLowerCase().replace(/\s+/g, '-')}`,
    name: t.title,
  })),
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbList)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </head>
  <body>
    <main class="max-w-7xl mx-auto px-4 py-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        {sectorName} Tenders in {provinceName}
      </h1>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">
        Looking for {sectorName} contracts in {provinceName}? You’re in the right
        place. Our platform aggregates every {sectorName} opportunity from
        provincial departments, municipalities, and state entities in
        {provinceName}. We update the list hourly so you never miss a
        closing date. Use the cards below to browse active bids, and
        register for alerts to get new tenders delivered straight to your
        inbox.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {filtered.map((tender) => (
          <TenderCard tender={tender} />
        ))}
      </div>

      <section class="bg-gray-50 rounded-2xl p-8 max-w-3xl">
        <h2 class="text-2xl font-semibold mb-6">FAQ</h2>
        <dl class="space-y-6">
          <div>
            <dt class="font-medium text-gray-900">
              Are there many {sectorName} tenders in {provinceName}?
            </dt>
            <dd class="mt-1 text-gray-600">
              Yes, {provinceName} regularly publishes {sectorName} bids
              for both small and large enterprises.
            </dd>
          </div>
          <div>
            <dt class="font-medium text-gray-900">
              How do I qualify for {sectorName} contracts?
            </dt>
            <dd class="mt-1 text-gray-600">
              You’ll need a valid tax clearance certificate, BBBEE
              certification, and relevant industry registrations.
            </dd>
          </div>
          <div>
            <dt class="font-medium text-gray-900">
              Can I get updates for only this category?
            </dt>
            <dd class="mt-1 text-gray-600">
              Absolutely – tenderpreneurs’s filters let you lock in
              {sectorName} tenders from {provinceName} and ignore the rest.
            </dd>
          </div>
        </dl>
      </section>
    </main>
  </body>
</html>