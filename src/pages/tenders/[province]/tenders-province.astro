---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
import TenderCard from '@/components/TenderCard.astro';
import tenders from '@/data/tenders-seed.json';

interface Tender {
  title: string;
  province: string;
  sector: string;
  closingDate?: string;
  closing_date?: string;
  description?: string;
  entity?: string;
  value?: string;
  status?: string;
  link?: string;
}

const provinceNames: Record<string, string> = {
  'eastern-cape': 'Eastern Cape',
  'free-state': 'Free State',
  'gauteng': 'Gauteng',
  'kwazulu-natal': 'KwaZulu-Natal',
  'limpopo': 'Limpopo',
  'mpumalanga': 'Mpumalanga',
  'northern-cape': 'Northern Cape',
  'north-west': 'North West',
  'western-cape': 'Western Cape',
};

export const getStaticPaths: GetStaticPaths = async () => {
  const provinces = [...new Set((tenders as Tender[]).map((t) => t.province))];
  return provinces.map((province) => ({
    params: { province },
  }));
};

const { province } = Astro.params;
if (!province) return Astro.redirect('/tenders');

const filtered = (tenders as Tender[]).filter(
  (t) => t.province.toLowerCase() === province.toLowerCase()
);

const provinceName = provinceNames[province] ?? province.charAt(0).toUpperCase() + province.slice(1);

const seoData = {
  title: `${provinceName} Government Tenders & Contracts | Tenderpreneur`,
  description: `Find the latest government tenders, RFQs and contracts in ${provinceName}. Get instant alerts and bid opportunities.`,
  canonical: `https://tenderpreneur.co.za/tenders/${province}`,
};

const faqs = [
  {
    q: `What types of tenders are available in ${provinceName}?`,
    a: `In ${provinceName}, you can find infrastructure, IT, professional services, and supply chain tenders published by national, provincial, and local government departments.`,
  },
  {
    q: `How do I bid on tenders in ${provinceName}?`,
    a: `To bid on a ${provinceName} tender, register on the eTender portal, download the bid documents, and submit before the closing date with all required compliance certificates.`,
  },
  {
    q: `Where can I get real-time alerts for ${provinceName} tenders?`,
    a: `Tenderpreneur monitors every official bulletin in ${provinceName} and sends you customised email alerts the moment a new opportunity is published.`,
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tenderpreneur.co.za/' },
    { '@type': 'ListItem', position: 2, name: 'Tenders', item: 'https://tenderpreneur.co.za/tenders' },
    { '@type': 'ListItem', position: 3, name: `${provinceName} Tenders`, item: `https://tenderpreneur.co.za/tenders/${province}` },
  ],
};
---

<BaseLayout>
  <SEO slot="head" {...seoData} schema={breadcrumbSchema} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-navy-900 to-civic-800 py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="breadcrumb mb-6">
        <ol class="flex items-center gap-2 text-sm text-sky-300">
          <li><a href="/" class="hover:text-white">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/tenders" class="hover:text-white">Tenders</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="text-white">{provinceName}</li>
        </ol>
      </nav>
      <h1 class="font-display text-4xl font-bold text-white sm:text-5xl">
        Tenders in {provinceName}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-sky-200">
        Browse open government procurement opportunities in {provinceName}. Updated regularly from all official sources.
      </p>
    </div>
  </section>

  <!-- Tender cards -->
  <section class="section bg-white dark:bg-navy-950">
    <div class="container">
      {filtered.length === 0 ? (
        <div class="text-center py-16">
          <div class="text-5xl mb-4" aria-hidden="true">📋</div>
          <h2 class="text-2xl font-bold text-[var(--color-navy)] dark:text-white mb-2">
            No tenders listed yet for {provinceName}
          </h2>
          <p class="text-[var(--color-text-muted)] max-w-md mx-auto mb-6">
            We're building the live feed. Sign up to get notified the moment {provinceName} tenders go live.
          </p>
          <a href="/tenders" class="btn-secondary">Browse all tenders</a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {filtered.map((tender) => (
            <TenderCard tender={tender} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm bg-[var(--color-surface-2)]">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold text-[var(--color-navy)] dark:text-white mb-8">
        Frequently Asked Questions
      </h2>
      <dl class="space-y-6">
        {faqs.map((faq) => (
          <div>
            <dt class="font-semibold text-[var(--color-navy)] dark:text-white">{faq.q}</dt>
            <dd class="mt-2 text-sm text-[var(--color-text-muted)]">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
