---
import type { GetStaticPaths } from 'astro';
import tenders from '../../data/tenders-seed.json';
import TenderCard from '../../components/TenderCard.astro';

interface Tender {
  title: string;
  province: string;
  sector: string;
  closingDate: string;
  description: string;
  link?: string;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const sectors = [...new Set(tenders.map((t: Tender) => t.sector))];
  return sectors.map((sector) => ({
    params: { sector },
  }));
};

const { sector } = Astro.params;
if (!sector) return Astro.redirect('/tenders');

const filtered = (tenders as Tender[]).filter(
  (t) => t.sector.toLowerCase() === sector.toLowerCase()
);

const sectorName = sector.charAt(0).toUpperCase() + sector.slice(1);

const metaTitle = `${sectorName} Tenders & Contracts – tenderpreneurs`;
const metaDescription = `Browse the latest ${sectorName} government tenders, RFQs and procurement opportunities across South Africa.`;

const faqs = [
  {
    question: `What are the most common ${sectorName} tenders?`,
    answer: `${sectorName} tenders typically include supply, installation, and maintenance contracts issued by national and provincial departments.`,
  },
  {
    question: `How often are new ${sectorName} tenders published?`,
    answer: `New ${sectorName} opportunities appear weekly on the eTender portal and in local newspapers. tenderpreneurs checks hourly for updates.`,
  },
  {
    question: `Can I get alerts for only ${sectorName} tenders?`,
    answer: `Yes – tenderpreneurs lets you filter alerts by sector, so you only see ${sectorName} bids that match your business.`,
  },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: filtered.slice(0, 10).map((t, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    url: `https://tenderpreneurs.co.za/tenders/${t.province}/${t.sector}/${t.title.toLowerCase().replace(/\s+/g, '-')}`,
    name: t.title,
  })),
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </head>
  <body>
    <main class="max-w-7xl mx-auto px-4 py-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        {sectorName} Tenders
      </h1>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">
        The {sectorName} sector is a cornerstone of South Africa’s public
        procurement landscape. Our trackers scan every government bulletin,
        municipal notice, and state‑owned entity RFQ to bring you the most
        current {sectorName} opportunities. Whether you specialise in
        infrastructure, professional services, or supply, you’ll find
        contracts that match your expertise. Bookmark this page or sign up
        for instant alerts so you’re always first to know when a new
        {sectorName} tender drops.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {filtered.map((tender) => (
          <TenderCard tender={tender} />
        ))}
      </div>

      <section class="bg-gray-50 rounded-2xl p-8 max-w-3xl">
        <h2 class="text-2xl font-semibold mb-6">FAQ</h2>
        <dl class="space-y-6">
          {faqs.map((faq) => (
            <div>
              <dt class="font-medium text-gray-900">{faq.question}</dt>
              <dd class="mt-1 text-gray-600">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    </main>
  </body>
</html>