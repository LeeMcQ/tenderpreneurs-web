---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StructuredData from "../../../components/StructuredData.astro";
import { peekEnv } from "../../../lib/db";
import { getSessionUser } from "../../../lib/auth/magic-link";
import { resolveWinScore } from "../../../lib/winscore-resolve";
import {
  bidNumber, closeWeekdayChip, displayTitle, docLabel, fmtCloseLong, fmtCloseTime,
  fmtValue, provinceLabel as labelProvince, urgency,
} from "../../../lib/tender-display";
import { bbbeeFromText, isThinRow, STANDARD_RETURNABLES } from "../../../lib/tender-enrich";
import { draftBidPack, findSimilarClosed, lessonsFromClosed, rememberComparables } from "../../../lib/tender-similar";
import { resolveLocation } from "../../../lib/tender-location";
import "../../../styles/tender-detail.css";

export const prerender = false;
const { id } = Astro.params;
let tender: any = null;
let history: any[] = [];
let documents: any[] = [];
let similar: any[] = [];
let authed = false;
let winData: any = null;
let bookmark: { notes: string | null } | null = null;

try {
  const env = peekEnv(Astro);
  if (env?.DB) {
    const user = await getSessionUser(env.DB, Astro.request.headers.get("cookie"));
    authed = !!user;
    tender = await env.DB.prepare(`SELECT * FROM tenders WHERE id = ? AND canonical_ref IS NULL`).bind(id).first();
    if (tender && authed && user) {
      try {
        const h = await env.DB.prepare(`SELECT change_type, old_value, new_value, changed_at FROM tender_history WHERE tender_id = ? ORDER BY changed_at DESC LIMIT 10`).bind(id).all();
        history = h.results || [];
      } catch {}
      try {
        bookmark = await env.DB.prepare(
          `SELECT notes FROM bookmarks WHERE user_id = ? AND tender_id = ?`,
        ).bind(user.id, id).first() as any;
      } catch { bookmark = null; }
    }
    try { winData = await resolveWinScore(env, user?.id ?? null, id); } catch { winData = null; }
    if (tender) {
      similar = await findSimilarClosed(env.DB, tender);
      await rememberComparables(env.DB, tender.id, similar);
    }
  }
} catch {}

if (tender?.documents_json) { try { documents = JSON.parse(tender.documents_json); } catch {}
}
if (!tender) return new Response("Tender not found", { status: 404 });

const title = displayTitle(tender);
const ref = bidNumber(tender);
const closingLong = fmtCloseLong(tender.closing_date);
const closingTime = fmtCloseTime(tender.closing_time);
const closeChip = closeWeekdayChip(tender.closing_date);
const urg = urgency(tender.closing_date, tender.closing_time);
const valueLabel = fmtValue(tender.estimated_value);
const provinceLabel = labelProvince(tender.province);
const place = resolveLocation(tender);
const bbbee = bbbeeFromText(tender.description, tender.evaluation_notes, tender.title);
const thin = isThinRow(tender);
const lessons = lessonsFromClosed(tender, similar);
const pack = draftBidPack(tender, similar);
let returnables = STANDARD_RETURNABLES;
if (tender.returnables_json) {
  try { const parsed = JSON.parse(tender.returnables_json); if (Array.isArray(parsed) && parsed.length) returnables = parsed; } catch {}
}
const SITE = "https://tenderpreneurs.co.za";
const tenderUrl = `${SITE}/tenders/t/${tender.id}`;
const lastChecked = tender.last_seen_at ? new Date(tender.last_seen_at).toLocaleDateString("en-ZA", { day: "numeric", month: "short", year: "numeric" }) : null;
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Tenders", url: "/tenders" },
  ...(tender.province ? [{ name: provinceLabel || tender.province, url: `/tenders/${tender.province}` }] : []),
  { name: title, url: `/tenders/t/${tender.id}` },
];
const tenderLd = {
  "@context": "https://schema.org",
  "@type": "Demand",
  name: title,
  ...(tender.description ? { description: String(tender.description).slice(0, 300) } : {}),
  ...(tender.published_date ? { availabilityStarts: tender.published_date } : {}),
  ...(tender.closing_date ? { availabilityEnds: tender.closing_date } : {}),
  areaServed: provinceLabel || "South Africa",
  ...(tender.procuring_entity ? { seller: { "@type": "GovernmentOrganization", name: tender.procuring_entity } } : {}),
  ...(ref || tender.source_ref ? { identifier: ref || tender.source_ref } : {}),
  url: tenderUrl,
};
---
<BaseLayout title={title} description={tender.description?.slice(0, 160) || `Government tender ${ref || tender.source_ref}`}>
  <StructuredData breadcrumbs={breadcrumbs} extra={[tenderLd]} />
  <div class="tdoc" data-tender-id={tender.id} data-thin={thin ? "1" : "0"} data-saved={bookmark ? "1" : "0"}>
    <div class="tdoc-wrap">
      <nav class="crumb" aria-label="Breadcrumb"><ol><li><a href="/tenders">Tenders</a></li>{tender.province && <li><a href={`/tenders/${tender.province}`}>{provinceLabel}</a></li>}</ol></nav>
      <p class="tdoc-kicker">{ref || tender.source_ref || "Official notice"}{tender.status && <span> · {tender.status}</span>}{closeChip && <span> · {closeChip}</span>}</p>
      <h1>{title}</h1>
      <p class="tdoc-meta">{tender.procuring_entity || "Procuring entity not published"}{place.label ? ` · ${place.label}` : ""}{lastChecked ? ` · last checked ${lastChecked}` : ""}</p>
      <div class="tdoc-grid">
        <div class={`tdoc-stat ${urg.cls === "u-red" ? "hot" : ""}`}><p class="lbl">Closing</p><p>{closingLong || "Not published"}</p><p class="sub">{closingTime ? `${closingTime} SAST` : urg.text}</p></div>
        <div class="tdoc-stat"><p class="lbl">Value</p><p>{valueLabel || "Not published"}</p><p class="sub">{tender.submission_method || "Check official method"}</p></div>
        <div class={`tdoc-stat ${tender.briefing_compulsory ? "warn-card" : ""}`}><p class="lbl">{tender.briefing_compulsory ? "Compulsory briefing" : "Briefing"}</p><p>{tender.briefing_date || "None published"}</p><p class="sub">{tender.briefing_location || "Venue on official notice"}</p></div>
        <div class="tdoc-stat"><p class="lbl">Can you bid?</p><p>{tender.cidb_grade ? `CIDB ${tender.cidb_grade}` : "No CIDB stated"}</p><p class="sub">{bbbee ? `B-BBEE ${bbbee}` : "B-BBEE in bid pack"}</p></div>
      </div>
      {thin && <p class="recover" id="recover-msg">Recovering omitted fields from the official eTenders release…</p>}
      {authed && (
        <section class="save-box" id="save-box">
          <div class="save-row">
            <button type="button" id="save-btn" class="src-btn">{bookmark ? "Saved — remove" : "Save this tender"}</button>
            <a href="/account">Open saved list</a>
          </div>
          <label for="save-note">Private note</label>
          <textarea id="save-note" rows="3" maxlength="2000" placeholder="Site visit, CIDB gap, who is pricing this…">{bookmark?.notes || ""}</textarea>
          <button type="button" id="save-note-btn" class="src-btn">Save note</button>
          <p id="save-status" class="sub"></p>
        </section>
      )}
      <section id="winscore" class="ws" data-tender-id={tender.id} aria-label="Win probability"><div class="ws-loading">Estimating your win probability…</div></section>
      {winData && <script id="win-data" type="application/json" set:html={JSON.stringify(winData)} />}
      <section id="verify" class="vf" data-tender-id={tender.id} aria-label="Tender verifier"><div class="vf-loading">Checking this tender for flaws…</div></section>
      {tender.description && <section><h2>What they are buying</h2><p class="tdoc-body">{tender.description}</p></section>}
      {tender.evaluation_notes && <section><h2>Conditions recovered from the official notice</h2><pre class="tdoc-notes">{tender.evaluation_notes}</pre></section>}
      <section>
        <h2>Bid-pack starter</h2>
        <p class="tdoc-body">{pack.summary}</p>
        <ul class="pack-list">{pack.sections.map((s) => <li>{s}</li>)}</ul>
        <h3 class="tdoc-sub">Standard returnables</h3>
        <ul class="pack-list">{returnables.map((r) => <li><code>{r.code}</code> <span>{r.label}</span></li>)}</ul>
      </section>
      {lessons.length > 0 && <section><h2>Checks against closed tenders</h2><ul class="gate-list">{lessons.map((l) => <li class={l.severity === "warning" ? "warn" : ""}>{l.message}</li>)}</ul></section>}
      {similar.length > 0 && <section><h2>Similar closed notices</h2><p class="tdoc-body">Kept so you can compare scope, price signals, and missing fields — not to copy a bid.</p><ul class="sim-list">{similar.map((s) => <li><a href={`/tenders/t/${s.id}`}><strong>{s.title}</strong><span class="sub">{[s.procuring_entity, s.closing_date, s.status].filter(Boolean).join(" · ")}</span></a></li>)}</ul></section>}
      {(tender.contact_name || tender.contact_email || tender.contact_phone) && <section><h2>Published contact</h2><dl class="tdoc-contact">{tender.contact_name && <div><dt>Name</dt><dd>{tender.contact_name}</dd></div>}{tender.contact_email && <div><dt>Email</dt><dd><a href={`mailto:${tender.contact_email}`}>{tender.contact_email}</a></dd></div>}{tender.contact_phone && <div><dt>Phone</dt><dd>{tender.contact_phone}</dd></div>}</dl></section>}
      {documents.length > 0 && <section><h2>Public bid documents</h2><ul class="doc-list">{documents.map((d) => <li><a href={d.url} target="_blank" rel="noopener noreferrer">{docLabel(d)}</a></li>)}</ul></section>}
      {tender.source_url && <p><a class="src-btn" href={tender.source_url} target="_blank" rel="noopener noreferrer">Open official eTenders notice</a></p>}
      {!authed && <section class="tdoc-gate"><h2>Save this tender</h2><p class="tdoc-body">Sign in to keep notes, history, and win probability against your profile. Documents and published contacts stay public.</p><form action="/api/auth/request" method="POST" class="tdoc-form"><input type="hidden" name="redirect_to" value={Astro.url.pathname} /><input type="email" name="email" required placeholder="you@yourcompany.co.za" /><button type="submit">Send sign-in link</button></form></section>}
      {history.length > 0 && <section><h2>Change history</h2><ul class="gate-list">{history.map((h) => <li><span>{h.changed_at?.slice(0, 10)}</span> {h.change_type}: {h.old_value} → {h.new_value}</li>)}</ul></section>}
    </div>
  </div>
</BaseLayout>
<script is:inline>
(function () {
  function initEnrich() {
    var root = document.querySelector('.tdoc');
    if (!root || root.getAttribute('data-thin') !== '1') return;
    var id = root.getAttribute('data-tender-id');
    if (!id) return;
    fetch('/api/tenders/' + id + '/enrich', { method: 'POST' }).then(function (r) { return r.json(); }).then(function (d) {
      if (d && d.ok && d.patch && Object.keys(d.patch).length) location.reload();
      else { var msg = document.getElementById('recover-msg'); if (msg) msg.textContent = 'Official release had nothing extra to add, or the catalogue is rate-limited today.'; }
    }).catch(function () { var msg = document.getElementById('recover-msg'); if (msg) msg.textContent = 'Could not reach the official eTenders release right now.'; });
  }
  function paintWin(el, data) {
    if (!el || !data) return;
    if (data.locked) {
      el.innerHTML = '<p class="tdoc-body">Sign in and add a supplier profile to see win probability.</p>';
      return;
    }
    var win = data.win || data;
    if (!win || win.score == null) { el.innerHTML = ''; return; }
    el.innerHTML = '<div class="tdoc-stat"><p class="lbl">Win probability</p><p>' +
      String(win.band || 'fit') + ' · ~' + Math.round(Number(win.score) || 0) + '%</p></div>';
  }
  var el = document.getElementById('winscore');
  var inline = document.getElementById('win-data');
  if (el && inline && inline.textContent) {
    try { paintWin(el, JSON.parse(inline.textContent)); } catch (e) {}
  } else if (el) {
    var wid = el.getAttribute('data-tender-id');
    if (wid) fetch('/api/tenders/' + wid + '/win-score').then(function (r) { return r.json(); }).then(function (d) { paintWin(el, d); }).catch(function () { el.innerHTML = ''; });
  }
  var vf = document.getElementById('verify');
  if (vf) {
    var vid = vf.getAttribute('data-tender-id');
    if (vid) fetch('/api/tenders/' + vid + '/report').then(function (r) { return r.json(); }).then(function (d) {
      if (!d || !d.ok || !d.published || d.health_score == null) { vf.innerHTML = ''; return; }
      vf.innerHTML = '<div class="tdoc-stat"><p class="lbl">Notice health</p><p>' + d.health_score + '/100</p></div>';
    }).catch(function () { vf.innerHTML = ''; });
  }
  var root = document.querySelector('.tdoc');
  var saveBtn = document.getElementById('save-btn');
  var noteBtn = document.getElementById('save-note-btn');
  var noteEl = document.getElementById('save-note');
  var statusEl = document.getElementById('save-status');
  function setSaved(on) {
    if (root) root.setAttribute('data-saved', on ? '1' : '0');
    if (saveBtn) saveBtn.textContent = on ? 'Saved — remove' : 'Save this tender';
  }
  function postBookmark(payload) {
    if (!root) return Promise.resolve();
    payload.tender_id = root.getAttribute('data-tender-id');
    if (statusEl) statusEl.textContent = 'Saving…';
    return fetch('/api/tenders/bookmark', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (d && d.ok) {
        setSaved(!!d.bookmarked);
        if (statusEl) statusEl.textContent = d.bookmarked ? 'Saved to your account.' : 'Removed from saved list.';
      } else if (statusEl) statusEl.textContent = (d && d.error === 'auth_required') ? 'Sign in to save.' : 'Could not save right now.';
    }).catch(function () { if (statusEl) statusEl.textContent = 'Could not save right now.'; });
  }
  if (saveBtn) saveBtn.addEventListener('click', function () {
    var on = root && root.getAttribute('data-saved') === '1';
    postBookmark({ action: on ? 'remove' : 'save', notes: noteEl ? noteEl.value : '' });
  });
  if (noteBtn) noteBtn.addEventListener('click', function () {
    postBookmark({ action: 'save', notes: noteEl ? noteEl.value : '' });
  });
  initEnrich();
})();
</script>
<style>
  .save-box { background:#fff; border:1px solid rgba(12,27,51,.12); border-radius:14px; padding:16px; margin:0 0 20px; }
  .save-row { display:flex; gap:16px; align-items:center; flex-wrap:wrap; margin-bottom:10px; }
  .save-box label { display:block; font-size:12px; color:#6B7787; margin-bottom:6px; }
  .save-box textarea { width:100%; border:1px solid rgba(12,27,51,.12); border-radius:10px; padding:10px; font:inherit; margin-bottom:10px; }
  .save-box .sub { margin:8px 0 0; color:#6B7787; font-size:13px; }
  .save-row a { color:#A66708; font-weight:600; }
</style>
