---
import type { GetStaticPaths } from 'astro';
import tenders from '../../data/tenders-seed.json';
import TenderCard from '../../components/TenderCard.astro';

interface Tender {
  title: string;
  province: string;
  sector: string;
  closingDate: string;
  description: string;
  link?: string;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const provinces = [...new Set(tenders.map((t: Tender) => t.province))];
  return provinces.map((province) => ({
    params: { province },
  }));
};

const { province } = Astro.params;
if (!province) return Astro.redirect('/tenders');

const filtered = (tenders as Tender[]).filter(
  (t) => t.province.toLowerCase() === province.toLowerCase()
);

const provinceName = province.charAt(0).toUpperCase() + province.slice(1);

const metaTitle = `${provinceName} Tenders & Government Contracts – tenderpreneurs`;
const metaDescription = `Find the latest government tenders, RFQs and contracts in ${provinceName}. Get instant alerts and bid opportunities.`;

const faqs = [
  {
    question: `What types of tenders are available in ${provinceName}?`,
    answer: `In ${provinceName}, you can find infrastructure, IT, professional services, and supply chain tenders published by national, provincial, and local government departments.`,
  },
  {
    question: `How do I bid on tenders in ${provinceName}?`,
    answer: `To bid on a ${provinceName} tender, register on the eTender portal, download the bid documents, and submit before the closing date with all required compliance certificates.`,
  },
  {
    question: `Where can I get real‑time alerts for ${provinceName} tenders?`,
    answer: `tenderpreneurs monitors every official bulletin in ${provinceName} and sends you customised email alerts the moment a new opportunity is published.`,
  },
];

const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tenderpreneurs.co.za/' },
    { '@type': 'ListItem', position: 2, name: 'Tenders', item: 'https://tenderpreneurs.co.za/tenders' },
    { '@type': 'ListItem', position: 3, name: `${provinceName} Tenders`, item: Astro.url.href },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbList)} />
  </head>
  <body>
    <main class="max-w-7xl mx-auto px-4 py-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">
        Tenders in {provinceName}
      </h1>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">
        {provinceName} is home to a wide array of government procurement opportunities
        spanning construction, healthcare, technology, and municipal services.
        Whether you are an established contractor or a first‑time bidder, staying
        on top of the latest {provinceName} tenders is critical for growing your
        business. Our platform consolidates notices from all official sources,
        so you never miss a closing date. With smart filtering and AI‑powered
        alerts, you can focus on the bids that match your capabilities and
        geographic footprint. Explore the live opportunities below, and start
        building your tender pipeline in {provinceName} today.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {filtered.map((tender) => (
          <TenderCard tender={tender} />
        ))}
      </div>

      <section class="bg-gray-50 rounded-2xl p-8 max-w-3xl">
        <h2 class="text-2xl font-semibold mb-6">
          Frequently Asked Questions
        </h2>
        <dl class="space-y-6">
          {faqs.map((faq) => (
            <div>
              <dt class="font-medium text-gray-900">{faq.question}</dt>
              <dd class="mt-1 text-gray-600">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    </main>
  </body>
</html>