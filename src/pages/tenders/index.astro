---
import BaseLayout from '../../layouts/BaseLayout.astro';

const provinces = [
  { slug: 'gauteng',        name: 'Gauteng',        blurb: 'Joburg, Tshwane, Ekurhuleni metros + provincial departments.' },
  { slug: 'western-cape',   name: 'Western Cape',   blurb: 'City of Cape Town, energy resilience, water infrastructure.' },
  { slug: 'kwazulu-natal',  name: 'KwaZulu-Natal',  blurb: 'eThekwini Metro, flood reconstruction, rural infrastructure.' },
  { slug: 'eastern-cape',   name: 'Eastern Cape',   blurb: 'NMB and Buffalo City metros, school infrastructure pipeline.' },
  { slug: 'free-state',     name: 'Free State',     blurb: 'Mangaung Metro, agri-infrastructure, district municipalities.' },
  { slug: 'limpopo',        name: 'Limpopo',        blurb: 'School infrastructure, platinum belt, Musina-Makhado SEZ.' },
  { slug: 'mpumalanga',     name: 'Mpumalanga',     blurb: 'Just energy transition, Highveld, Lowveld agri-tourism.' },
  { slug: 'north-west',     name: 'North West',     blurb: 'Platinum belt, Rustenburg, Mahikeng, mining-adjacent work.' },
  { slug: 'northern-cape',  name: 'Northern Cape',  blurb: 'Renewable energy IPPs, mining services, Kimberley to Upington.' },
];

const sectors = [
  { slug: 'construction', name: 'Construction', blurb: 'SANRAL, provincial public works, water boards. CIDB-graded.', status: 'live' },
  { slug: 'ict',          name: 'ICT',          blurb: 'SITA, departmental systems, municipal smart infrastructure.', status: 'live' },
  { slug: 'health',       name: 'Health',       blurb: 'Pharmaceuticals, medical equipment, facility services.', status: 'live' },
  { slug: 'education',    name: 'Education',    blurb: 'School infrastructure, scholar transport, nutrition, e-learning.', status: 'live' },
  { slug: 'security',     name: 'Security',     blurb: 'Physical guarding, electronic, access control. PSIRA-regulated.', status: 'live' },
  { slug: 'transport',    name: 'Transport',    blurb: 'Fleet, scholar transport, rail, aviation, BRT systems.', status: 'soon' },
  { slug: 'agriculture',  name: 'Agriculture',  blurb: 'Agri-infrastructure, fencing, irrigation, veterinary services.', status: 'soon' },
  { slug: 'energy',       name: 'Energy',       blurb: 'Eskom, municipal embedded gen, JET, solar PV and storage.', status: 'soon' },
  { slug: 'consulting',   name: 'Consulting',   blurb: 'Built-environment PSPs, management, IT advisory, audit.', status: 'soon' },
  { slug: 'cleaning',     name: 'Cleaning',     blurb: 'Facility cleaning, hospital hygiene, hygiene consumables.', status: 'soon' },
  { slug: 'catering',     name: 'Catering',     blurb: 'Hospital patient meals, NSNP, institutional catering.', status: 'soon' },
  { slug: 'legal',        name: 'Legal',        blurb: 'State Attorney panels, litigation, conveyancing, advisory.', status: 'soon' },
];
---

<BaseLayout
  title="Browse Tenders by Province and Sector — Tenderpreneurs"
  description="Find South African government tender opportunities by province (all 9) or sector. Live feed from eTenders and procuring departments."
>
  <section class="container mx-auto px-4 py-12 max-w-6xl">
    <header class="mb-10">
      <p class="text-sm uppercase tracking-wide text-amber-400 font-semibold mb-2">Tender hubs</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">Browse Tenders</h1>
      <p class="text-lg text-slate-300 max-w-prose">
        Government tender opportunities across South Africa, organised by province and sector.
        Top 5 latest opportunities visible to everyone, full feed free with email sign-in.
      </p>
    </header>

    <!-- Provinces -->
    <section class="mb-14">
      <h2 class="text-2xl font-bold text-white mb-2">By province</h2>
      <p class="text-sm text-slate-400 mb-6">All 9 provinces.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {provinces.map((p) => (
          <a
            href={`/tenders/${p.slug}`}
            class="group block rounded-xl bg-slate-800/50 border border-slate-700 p-5 transition hover:border-amber-500 hover:bg-slate-800"
          >
            <h3 class="text-lg font-semibold text-white mb-1 group-hover:text-amber-400 transition">
              {p.name}
            </h3>
            <p class="text-sm text-slate-300">{p.blurb}</p>
            <p class="mt-3 text-xs font-medium text-amber-400 group-hover:underline">
              View tenders →
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Sectors -->
    <section>
      <h2 class="text-2xl font-bold text-white mb-2">By sector</h2>
      <p class="text-sm text-slate-400 mb-6">12 sectors. 5 live now, 7 coming soon.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sectors.map((s) => (
          <a
            href={`/tenders/${s.slug}`}
            class="group block rounded-xl bg-slate-800/50 border border-slate-700 p-5 transition hover:border-amber-500 hover:bg-slate-800 relative"
          >
            {s.status === 'soon' && (
              <span class="absolute top-3 right-3 inline-flex items-center rounded-full bg-slate-700 px-2 py-0.5 text-[10px] uppercase tracking-wider text-slate-300">
                Soon
              </span>
            )}
            <h3 class="text-lg font-semibold text-white mb-1 group-hover:text-amber-400 transition">
              {s.name}
            </h3>
            <p class="text-sm text-slate-300">{s.blurb}</p>
            <p class="mt-3 text-xs font-medium text-amber-400 group-hover:underline">
              {s.status === 'live' ? 'View tenders →' : 'View hub →'}
            </p>
          </a>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
