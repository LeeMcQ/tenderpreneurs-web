---
// src/pages/tenders/index.astro
// Phase 2 placeholder — honest copy + working waitlist form.
// When the live feed ships, swap the body for the real listing.

import BaseLayout from "../../layouts/BaseLayout.astro";
import WaitlistForm from "../../components/WaitlistForm.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { TENDER_STATS, FEATURES, CTA } from "../../config/site";

const title = "Browse Government Tenders | Tenderpreneur";
const description = TENDER_STATS.isLive
  ? `Browse ${TENDER_STATS.tracking.toLocaleString()}+ open South African government tenders from etenders.gov.za. Filter by province, sector, value, and B-BBEE level.`
  : `Tracking ${TENDER_STATS.tracking.toLocaleString()}+ South African government tenders. The live feed is launching soon — join the waitlist for early access.`;
---

<BaseLayout title={title} description={description}>
  <main id="main-content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Tenders</li>
      </ol>
    </nav>

    <header class="tenders-hero">
      <div class="hero-status">
        <StatusBadge
          status={FEATURES.liveTenderFeed.status}
          eta={FEATURES.liveTenderFeed.eta}
        />
      </div>
      <h1>
        Tracking <strong>{TENDER_STATS.tracking.toLocaleString()}+</strong> South African government tenders
      </h1>
      <p class="lede">
        We're integrating with etenders.gov.za, 9 provincial procurement portals, and 257
        municipal websites. Join the waitlist and we'll notify you the moment the live feed
        goes live.
      </p>
    </header>

    <section class="waitlist-card" aria-labelledby="waitlist-h">
      <div class="emoji" aria-hidden="true">🚀</div>
      <h2 id="waitlist-h">Live tender feed — coming soon</h2>
      <p>Get notified when full access opens. No credit card required.</p>
      <WaitlistForm source="tenders-page" />
    </section>

    <section class="preview-grid" aria-labelledby="preview-h">
      <h2 id="preview-h" class="sr-only">What's included when the feed goes live</h2>

      <article class="preview-card">
        <h3>Full tender feed</h3>
        <p>
          {TENDER_STATS.tracking.toLocaleString()}+ tenders from etenders.gov.za, 9 provincial
          portals, and 257 municipalities. Refreshed every 4 hours.
        </p>
        <StatusBadge status={FEATURES.liveTenderFeed.status} eta={FEATURES.liveTenderFeed.eta} />
      </article>

      <article class="preview-card">
        <h3>Smart filters</h3>
        <p>Filter by province, sector, CIDB grade, B-BBEE level, value range, and closing date.</p>
        <StatusBadge status={FEATURES.provinceFilters.status} eta={FEATURES.provinceFilters.eta} />
      </article>

      <article class="preview-card">
        <h3>Email alerts</h3>
        <p>Save search filters and get notified when matching tenders are published.</p>
        <StatusBadge status={FEATURES.emailAlerts.status} eta={FEATURES.emailAlerts.eta} />
      </article>

      <article class="preview-card">
        <h3>AI win-probability</h3>
        <p>Get a score from 0–100 based on your B-BBEE, CSD status, experience, and pricing.</p>
        <StatusBadge status={FEATURES.winProbability.status} eta={FEATURES.winProbability.eta} />
      </article>
    </section>

    <section class="ready-now" aria-labelledby="ready-h">
      <h2 id="ready-h">Already available — free</h2>
      <p>
        While the live feed is being built, you can already use the free PFMA Knowledge Base
        and AI Assistant to prepare your business for tender season.
      </p>
      <div class="cta-row">
        <a href={CTA.pfmaGuide} class="btn-primary">Browse PFMA Guide</a>
        <a href={CTA.assistant} class="btn-secondary">Try the AI Assistant</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 920px;
    margin: 0 auto;
    padding: 32px 20px 80px;
  }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: #6b7280;
  }
  .breadcrumb a { color: #0C1B33; }
  .tenders-hero {
    padding: 24px 0 32px;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 32px;
  }
  .hero-status { margin-bottom: 12px; }
  .tenders-hero h1 {
    font-size: clamp(28px, 5vw, 42px);
    line-height: 1.15;
    margin: 0 0 12px;
    color: #0C1B33;
  }
  .tenders-hero h1 strong { color: #0C1B33; }
  .lede {
    font-size: 17px;
    color: #4b5563;
    max-width: 640px;
    line-height: 1.5;
    margin: 0;
  }
  .waitlist-card {
    background: linear-gradient(135deg, #0C1B33 0%, #1e3a5f 100%);
    color: #fff;
    padding: 36px 28px;
    border-radius: 16px;
    text-align: center;
    margin-bottom: 48px;
  }
  .waitlist-card .emoji { font-size: 36px; margin-bottom: 8px; }
  .waitlist-card h2 {
    color: #fff;
    margin: 0 0 8px;
    font-size: 24px;
  }
  .waitlist-card p {
    color: #cbd5e1;
    margin: 0 0 20px;
  }
  .waitlist-card :global(.waitlist-form) {
    margin: 0 auto;
  }
  .waitlist-card :global(.waitlist-meta) {
    color: #94a3b8;
  }
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 48px;
  }
  .preview-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 20px;
  }
  .preview-card h3 {
    margin: 0 0 8px;
    font-size: 16px;
    color: #0C1B33;
  }
  .preview-card p {
    margin: 0 0 12px;
    color: #4b5563;
    font-size: 14px;
    line-height: 1.5;
  }
  .ready-now {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 28px;
    text-align: center;
  }
  .ready-now h2 { margin: 0 0 8px; color: #0C1B33; }
  .ready-now p { margin: 0 0 20px; color: #4b5563; }
  .cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary, .btn-secondary {
    padding: 12px 22px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
  }
  .btn-primary { background: #0C1B33; color: #fff; }
  .btn-secondary { background: transparent; color: #0C1B33; border: 1px solid #0C1B33; }
  .btn-primary:hover { opacity: 0.92; }
  .btn-secondary:hover { background: rgba(12, 27, 51, 0.05); }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
