---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEO from '@/components/SEO.astro';
---

<BaseLayout bodyClass="bg-[var(--color-surface-2)]">
  <SEO slot="head" title="Payment Cancelled — Tenderpreneur" description="Your payment was cancelled." noIndex={true} />

  <section class="section">
    <div class="container max-w-lg text-center">
      <div class="card p-10">
        <div class="text-5xl mb-4" aria-hidden="true">💳</div>
        <h1 class="text-2xl font-bold text-amber-700 dark:text-amber-400 mb-2">
          Payment cancelled
        </h1>
        <p class="text-[var(--color-text-muted)] mb-6">
          No worries — you can upgrade anytime when you're ready.
        </p>
        <a href="/pricing" class="btn-secondary">← Back to pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>
