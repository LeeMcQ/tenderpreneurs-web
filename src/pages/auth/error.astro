---
/**
 * /auth/error
 * Shown when magic-link auth fails (expired, already used, invalid).
 * Dark navy theme — matches the rest of the site.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const reason = Astro.url.searchParams.get('reason') ?? 'unknown';

const messages: Record<string, { title: string; body: string }> = {
  expired:   { title: 'Link expired',      body: 'This sign-in link has expired. Links are valid for 15 minutes — please request a new one.' },
  used:      { title: 'Link already used', body: 'This sign-in link has already been used. Please request a new one.' },
  invalid:   { title: 'Invalid link',      body: 'This sign-in link is not valid. It may have been corrupted or tampered with.' },
  unknown:   { title: 'Something went wrong', body: 'We couldn\'t sign you in. Please try again.' },
};

const { title, body } = messages[reason] ?? messages.unknown;
---

<BaseLayout
  title={`${title} — Tenderpreneurs`}
  description="There was a problem signing you in."
>
  <main class="auth-page">
    <div class="auth-card">
      <div class="icon-wrap error">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
          width="48" height="48" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>

      <h1>{title}</h1>
      <p class="lead">{body}</p>

      <div class="divider"></div>

      <a href="/auth/login" class="btn-primary">Request a new link</a>

      <p class="footer-note">
        Need help?{' '}
        <a href="mailto:support@tenderpreneurs.co.za">Contact support</a>
      </p>
    </div>
  </main>
</BaseLayout>

<style>
  .auth-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .auth-card {
    background: var(--color-card-bg, #1e2a3a);
    border: 1px solid var(--color-border, #2d3f55);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    max-width: 440px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .icon-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.25rem;
  }

  .icon-wrap.error {
    background: rgba(239, 68, 68, 0.12);
    color: #ef4444;
  }

  h1 {
    font-size: 1.65rem;
    color: var(--color-text, #e2e8f0);
    margin: 0;
  }

  .lead {
    font-size: 1rem;
    color: var(--color-muted, #94a3b8);
    line-height: 1.65;
    margin: 0;
  }

  .divider {
    width: 100%;
    height: 1px;
    background: var(--color-border, #2d3f55);
    margin: 0.25rem 0;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-amber, #f59e0b);
    color: #0f1923;
    font-weight: 700;
    padding: 0.7rem 1.75rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.95rem;
    transition: background 0.15s;
  }

  .btn-primary:hover {
    background: #d97706;
  }

  .footer-note {
    font-size: 0.88rem;
    color: var(--color-muted, #94a3b8);
    margin: 0;
  }

  .footer-note a {
    color: var(--color-amber, #f59e0b);
    text-decoration: none;
  }

  .footer-note a:hover {
    text-decoration: underline;
  }
</style>
