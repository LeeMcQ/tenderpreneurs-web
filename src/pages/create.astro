---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const title = 'Create a draft | Tender creation assistant';
const description = 'Upload a previous tender or RFQ and draft the next notice in that format.';
---
<BaseLayout title={title} description={description}>
  <div class="pub">
    <p class="pub-kicker">Tender creation assistant</p>
    <h1>Create a draft from how you usually write</h1>
    <p class="pub-lede">Upload a previous tender or RFQ. We use it only as the format your organisation already uses. This is not <a href="/tenders">Find tenders</a>.</p>
    <div class="pub-split">
      <form id="create-form" class="pub-form">
        <label>Previous tender or RFQ (format sample)
          <input id="sample-file" name="sample" type="file" accept=".txt,.md,.csv,.html,.htm,text/plain" />
        </label>
        <p class="pub-note">PDF and Word stay on your machine. Export or paste plain text. We do not store the upload.</p>
        <label>Notice title<input name="title" required placeholder="Appointment of a service provider for..." /></label>
        <label>Procuring entity<input name="entity" /></label>
        <label>Scope / description<textarea name="description" rows="8"></textarea></label>
        <div class="pub-row">
          <label>Closing date<input name="closing_date" type="date" /></label>
          <label>Briefing date<input name="briefing_date" type="date" /></label>
          <label class="pub-check"><input name="briefing_compulsory" type="checkbox" /> Compulsory briefing</label>
        </div>
        <div class="pub-row">
          <label>CIDB<input name="cidb" /></label>
          <label>Contact email<input name="contact_email" type="email" /></label>
        </div>
        <button type="submit" class="pub-btn">Review this draft</button>
        <a class="pub-link" href="/review">Open Reviewer</a>
      </form>
      <aside id="create-out" class="pub-out"><p class="pub-empty">Fill the notice, then Review.</p></aside>
    </div>
  </div>
</BaseLayout>
<style>
  .pub { max-width: 1120px; margin: 0 auto; padding: 28px 20px 80px; color: #e2e8f0; }
  .pub-kicker { text-transform:uppercase; letter-spacing:.08em; font-size:12px; color:#f59e0b; }
  .pub h1 { color:#fff; }
  .pub-lede a { color:#f59e0b; }
  .pub-split { display:grid; gap:24px; margin-top:28px; }
  @media (min-width:960px) { .pub-split { grid-template-columns: 1.15fr .85fr; } }
  .pub-form, .pub-out { background:#0f1c33; border:1px solid rgba(255,255,255,.08); border-radius:16px; padding:20px; }
  .pub-form label { display:flex; flex-direction:column; gap:6px; font-size:13px; color:#94a3b8; margin-bottom:12px; }
  .pub-form input, .pub-form textarea { background:#0b1426; border:1px solid #334155; color:#fff; border-radius:8px; padding:10px 12px; }
  .pub-row { display:grid; gap:12px; }
  .pub-btn { background:#d97706; color:#0c1b33; font-weight:700; border:0; border-radius:8px; padding:12px 18px; }
  .pub-link { color:#fbbf24; }
  .pub-note, .pub-empty { font-size:13px; color:#94a3b8; }
  .pub-card { border:1px solid rgba(255,255,255,.08); border-radius:10px; padding:12px; margin:10px 0; }
</style>
<script is:inline>
(function () {
  var form = document.getElementById('create-form');
  var out = document.getElementById('create-out');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var fd = new FormData(form);
    out.innerHTML = '<p class="pub-empty">Reviewing draft…</p>';
    fetch('/api/tenders/review-draft', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        title: fd.get('title'),
        description: fd.get('description'),
        closing_date: fd.get('closing_date'),
        briefing_date: fd.get('briefing_date'),
        briefing_compulsory: fd.get('briefing_compulsory') === 'on',
        cidb: fd.get('cidb'),
        contact_email: fd.get('contact_email'),
        procuring_entity: fd.get('entity'),
      }),
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (!d || !d.ok) { out.innerHTML = '<p class="pub-empty">' + ((d && d.error) || 'Review failed.') + '</p>'; return; }
      out.innerHTML = '<p>' + d.health_score + '/100</p>' + (d.findings||[]).map(function (f) {
        return '<article class="pub-card"><strong>' + (f.severity||'') + '</strong><p>' + (f.message||'') + '</p></article>';
      }).join('');
    });
  });
})();
</script>
