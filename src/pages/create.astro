---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const title = 'Create a tender notice | Tenderpreneurs';
const description = 'Draft a South African government tender notice before you publish it on eTenders. Separate from finding open tenders.';
---
<BaseLayout title={title} description={description}>
  <div class="pub">
    <nav class="pub-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Create notice</span>
    </nav>
    <p class="pub-kicker">For procuring entities</p>
    <h1>Tender Creator</h1>
    <p class="pub-lede">Write the notice you will advertise. This is not Find tenders. Suppliers browse live bids on <a href="/tenders">Find tenders</a>. You review the draft here, then publish on the official portal.</p>
    <div class="pub-split">
      <form id="create-form" class="pub-form">
        <label>Notice title<input name="title" required placeholder="e.g. Appointment of a service provider for..." /></label>
        <label>Procuring entity<input name="entity" placeholder="Department, municipality, or SOE" /></label>
        <label>Scope / description<textarea name="description" rows="8" placeholder="What is being bought, where, and on what terms."></textarea></label>
        <div class="pub-row">
          <label>Publish date<input name="published_date" type="date" /></label>
          <label>Closing date<input name="closing_date" type="date" /></label>
          <label>Closing time<input name="closing_time" type="time" /></label>
        </div>
        <div class="pub-row">
          <label>Briefing date<input name="briefing_date" type="date" /></label>
          <label class="pub-check"><input name="briefing_compulsory" type="checkbox" /> Compulsory briefing</label>
        </div>
        <div class="pub-row">
          <label>Estimated value (R)<input name="value" type="number" min="0" step="1" /></label>
          <label>CIDB grade<input name="cidb" placeholder="e.g. 4CE" /></label>
          <label>Preference system
            <select name="preference_system">
              <option value="">Not set</option>
              <option value="80/20">80/20</option>
              <option value="90/10">90/10</option>
            </select>
          </label>
        </div>
        <div class="pub-row">
          <label>Contact name<input name="contact_name" /></label>
          <label>Contact email<input name="contact_email" type="email" /></label>
          <label>Contact phone<input name="contact_phone" /></label>
        </div>
        <div class="pub-actions">
          <button type="submit" class="pub-btn">Review this draft</button>
          <a class="pub-link" href="/review">Already have wording? Open Reviewer</a>
        </div>
        <p class="pub-note">Guidance only. You still publish on eTenders or your entity portal.</p>
      </form>
      <aside id="create-out" class="pub-out" aria-live="polite">
        <p class="pub-empty">Fill the notice, then Review. Findings appear here before you advertise.</p>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .pub { max-width: 1120px; margin: 0 auto; padding: 28px 20px 80px; color: #e2e8f0; }
  .pub-crumb { display:flex; gap:8px; font-size:14px; color:#94a3b8; margin-bottom:18px; }
  .pub-crumb a { color:#f8fafc; }
  .pub-kicker { text-transform:uppercase; letter-spacing:.08em; font-size:12px; color:#f59e0b; margin:0; }
  .pub h1 { font-size:clamp(28px,4vw,42px); margin:6px 0 12px; color:#fff; }
  .pub-lede { max-width:68ch; color:#cbd5e1; line-height:1.6; }
  .pub-lede a { color:#f59e0b; }
  .pub-split { display:grid; gap:24px; margin-top:28px; }
  @media (min-width:960px) { .pub-split { grid-template-columns: 1.15fr .85fr; } }
  .pub-form, .pub-out { background:#0f1c33; border:1px solid rgba(255,255,255,.08); border-radius:16px; padding:20px; }
  .pub-form label { display:flex; flex-direction:column; gap:6px; font-size:13px; color:#94a3b8; margin-bottom:12px; }
  .pub-form input, .pub-form textarea, .pub-form select { background:#0b1426; border:1px solid #334155; color:#fff; border-radius:8px; padding:10px 12px; font:inherit; }
  .pub-row { display:grid; gap:12px; }
  @media (min-width:640px) { .pub-row { grid-template-columns: repeat(3,1fr); } }
  .pub-check { flex-direction:row !important; align-items:center; gap:8px; margin-top:22px; }
  .pub-actions { display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-top:8px; }
  .pub-btn { background:#d97706; color:#0c1b33; font-weight:700; border:0; border-radius:8px; padding:12px 18px; cursor:pointer; }
  .pub-link { color:#fbbf24; font-size:14px; }
  .pub-note, .pub-empty { font-size:13px; color:#94a3b8; }
  .pub-score { font-size:28px; font-weight:700; color:#fff; margin:0 0 8px; }
  .pub-card { border:1px solid rgba(255,255,255,.08); border-radius:10px; padding:12px; margin:10px 0; }
  .sev-critical { border-color:#ef4444; } .sev-warning { border-color:#f59e0b; }
</style>
<script is:inline>
(function () {
  var form = document.getElementById('create-form');
  var out = document.getElementById('create-out');
  function paint(d) {
    if (!d || !d.ok) { out.innerHTML = '<p class="pub-empty">' + (d && d.error ? d.error : 'Review failed.') + '</p>'; return; }
    var findings = d.findings || [];
    out.innerHTML = '<p class="pub-score">' + (d.health_score != null ? d.health_score : '—') +
      '/100</p><p class="pub-empty">' + (d.counts.critical||0) + ' critical · ' +
      (d.counts.warning||0) + ' warnings. Not published yet.</p>' +
      findings.map(function (f) {
        return '<article class="pub-card sev-' + (f.severity||'info') + '"><strong>' +
          (f.severity||'') + '</strong><p>' + String(f.message||f.problem||'') +
          '</p>' + (f.suggested_action || f.suggestion ? '<p>' + String(f.suggested_action||f.suggestion) + '</p>' : '') +
          '</article>';
      }).join('') +
      '<p class="pub-empty">' + (d.note||'') + '</p>';
  }
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var fd = new FormData(form);
    out.innerHTML = '<p class="pub-empty">Reviewing draft…</p>';
    fetch('/api/tenders/review-draft', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        title: fd.get('title'),
        description: fd.get('description'),
        published_date: fd.get('published_date'),
        closing_date: fd.get('closing_date'),
        closing_time: fd.get('closing_time'),
        briefing_date: fd.get('briefing_date'),
        briefing_compulsory: fd.get('briefing_compulsory') === 'on',
        value: fd.get('value') ? Number(fd.get('value')) : null,
        cidb: fd.get('cidb'),
        preference_system: fd.get('preference_system'),
        contact_name: fd.get('contact_name'),
        contact_email: fd.get('contact_email'),
        contact_phone: fd.get('contact_phone'),
        procuring_entity: fd.get('entity'),
      }),
    }).then(function (r) { return r.json(); }).then(paint).catch(function () {
      out.innerHTML = '<p class="pub-empty">Could not reach the reviewer.</p>';
    });
  });
})();
</script>
