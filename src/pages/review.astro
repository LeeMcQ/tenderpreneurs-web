---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const title = 'Review a draft | Tender creation assistant';
const description = 'Upload a draft or paste a published tender link. We flag gaps, loopholes, and fixes.';
---
<BaseLayout title={title} description={description}>
  <div class="pub">
    <p class="pub-kicker">Tender creation assistant</p>
    <h1>Review a draft or a published notice</h1>
    <p class="pub-lede">Upload what you have written, or paste a link. We look for missing items, exploitable wording, and how to tighten it. Start from a sample on <a href="/create">Create a draft</a>.</p>
    <div class="pub-split">
      <form id="review-form" class="pub-form">
        <label>Draft title<input name="title" /></label>
        <label>Upload the draft<input id="review-file" name="file" type="file" accept=".txt,.md,.csv,.html,.htm,text/plain" /></label>
        <label>Or a link to the published notice<input name="source_url" type="url" placeholder="https://www.etenders.gov.za/..." /></label>
        <label>Full draft text<textarea name="text" rows="16"></textarea></label>
        <button type="submit" class="pub-btn">Run pre-publish review</button>
      </form>
      <aside id="review-out" class="pub-out"><p class="pub-empty">Paste or upload a draft.</p></aside>
    </div>
  </div>
</BaseLayout>
<style>
  .pub { max-width: 1120px; margin: 0 auto; padding: 28px 20px 80px; color: #e2e8f0; }
  .pub-kicker { text-transform:uppercase; letter-spacing:.08em; font-size:12px; color:#f59e0b; }
  .pub h1 { color:#fff; }
  .pub-lede a { color:#f59e0b; }
  .pub-split { display:grid; gap:24px; margin-top:28px; }
  @media (min-width:960px) { .pub-split { grid-template-columns: 1.1fr .9fr; } }
  .pub-form, .pub-out { background:#0f1c33; border:1px solid rgba(255,255,255,.08); border-radius:16px; padding:20px; }
  .pub-form label { display:flex; flex-direction:column; gap:6px; font-size:13px; color:#94a3b8; margin-bottom:12px; }
  .pub-form input, .pub-form textarea { background:#0b1426; border:1px solid #334155; color:#fff; border-radius:8px; padding:10px 12px; }
  .pub-btn { background:#d97706; color:#0c1b33; font-weight:700; border:0; border-radius:8px; padding:12px 18px; }
  .pub-empty { font-size:13px; color:#94a3b8; }
  .pub-card { border:1px solid rgba(255,255,255,.08); border-radius:10px; padding:12px; margin:10px 0; }
</style>
<script is:inline>
(function () {
  var form = document.getElementById('review-form');
  var out = document.getElementById('review-out');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var fd = new FormData(form);
    out.innerHTML = '<p class="pub-empty">Scanning draft…</p>';
    var fileEl = document.getElementById('review-file');
    var file = fileEl && fileEl.files && fileEl.files[0];
    function send(text) {
      fetch('/api/tenders/review-draft', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ title: fd.get('title'), text: text, source_url: fd.get('source_url') }),
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d || !d.ok) { out.innerHTML = '<p class="pub-empty">' + ((d && d.error) || 'Review failed.') + '</p>'; return; }
        out.innerHTML = '<p>' + d.health_score + '/100</p>' + (d.findings||[]).map(function (f) {
          return '<article class="pub-card"><strong>' + (f.severity||'') + '</strong><p>' + (f.message||'') + '</p></article>';
        }).join('');
      });
    }
    if (file) {
      var reader = new FileReader();
      reader.onload = function () { send(String(reader.result || fd.get('text') || '')); };
      reader.readAsText(file);
    } else send(fd.get('text'));
  });
})();
</script>
