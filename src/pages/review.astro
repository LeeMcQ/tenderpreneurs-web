---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const title = 'Review a tender before publishing | Tenderpreneurs';
const description = 'Paste a draft tender notice and get a pre-publish quality review. Separate from finding open tenders.';
---
<BaseLayout title={title} description={description}>
  <div class="pub">
    <nav class="pub-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Review draft</span>
    </nav>
    <p class="pub-kicker">Before you advertise</p>
    <h1>Tender Reviewer</h1>
    <p class="pub-lede">Paste the wording you are about to publish. We flag missing dates, vague scope, brand-lock specs, and checklist gaps. This is not <a href="/tenders">Find tenders</a>. For a blank form start at <a href="/create">Tender Creator</a>.</p>
    <div class="pub-split">
      <form id="review-form" class="pub-form">
        <label>Draft title <span>(optional if the text already has one)</span><input name="title" placeholder="Notice title" /></label>
        <label>Full draft text<textarea name="text" rows="16" required placeholder="Paste the invitation to bid, RFQ, or memo you will publish."></textarea></label>
        <div class="pub-actions">
          <button type="submit" class="pub-btn">Run pre-publish review</button>
        </div>
        <p class="pub-note">Does not file the notice. You still publish on eTenders or your own portal.</p>
      </form>
      <aside id="review-out" class="pub-out" aria-live="polite">
        <p class="pub-empty">Paste a draft. Findings stay on this page until you copy the fixes back into your document.</p>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .pub { max-width: 1120px; margin: 0 auto; padding: 28px 20px 80px; color: #e2e8f0; }
  .pub-crumb { display:flex; gap:8px; font-size:14px; color:#94a3b8; margin-bottom:18px; }
  .pub-crumb a { color:#f8fafc; }
  .pub-kicker { text-transform:uppercase; letter-spacing:.08em; font-size:12px; color:#f59e0b; margin:0; }
  .pub h1 { font-size:clamp(28px,4vw,42px); margin:6px 0 12px; color:#fff; }
  .pub-lede { max-width:68ch; color:#cbd5e1; line-height:1.6; }
  .pub-lede a { color:#f59e0b; }
  .pub-split { display:grid; gap:24px; margin-top:28px; }
  @media (min-width:960px) { .pub-split { grid-template-columns: 1.1fr .9fr; } }
  .pub-form, .pub-out { background:#0f1c33; border:1px solid rgba(255,255,255,.08); border-radius:16px; padding:20px; }
  .pub-form label { display:flex; flex-direction:column; gap:6px; font-size:13px; color:#94a3b8; margin-bottom:12px; }
  .pub-form input, .pub-form textarea { background:#0b1426; border:1px solid #334155; color:#fff; border-radius:8px; padding:10px 12px; font:inherit; }
  .pub-actions { margin-top:8px; }
  .pub-btn { background:#d97706; color:#0c1b33; font-weight:700; border:0; border-radius:8px; padding:12px 18px; cursor:pointer; }
  .pub-note, .pub-empty { font-size:13px; color:#94a3b8; }
  .pub-score { font-size:28px; font-weight:700; color:#fff; margin:0 0 8px; }
  .pub-card { border:1px solid rgba(255,255,255,.08); border-radius:10px; padding:12px; margin:10px 0; }
  .sev-critical { border-color:#ef4444; } .sev-warning { border-color:#f59e0b; }
</style>
<script is:inline>
(function () {
  var form = document.getElementById('review-form');
  var out = document.getElementById('review-out');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var fd = new FormData(form);
    out.innerHTML = '<p class="pub-empty">Scanning draft…</p>';
    fetch('/api/tenders/review-draft', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ title: fd.get('title'), text: fd.get('text') }),
    }).then(function (r) { return r.json(); }).then(function (d) {
      if (!d || !d.ok) { out.innerHTML = '<p class="pub-empty">' + (d && d.error ? d.error : 'Review failed.') + '</p>'; return; }
      var findings = d.findings || [];
      out.innerHTML = '<p class="pub-score">' + (d.health_score != null ? d.health_score : '—') +
        '/100</p><p class="pub-empty">' + (d.counts.critical||0) + ' critical · ' +
        (d.counts.warning||0) + ' warnings</p>' +
        findings.map(function (f) {
          return '<article class="pub-card sev-' + (f.severity||'info') + '"><strong>' +
            (f.severity||'') + '</strong><p>' + String(f.message||f.problem||'') + '</p></article>';
        }).join('');
    }).catch(function () {
      out.innerHTML = '<p class="pub-empty">Could not reach the reviewer.</p>';
    });
  });
})();
</script>
