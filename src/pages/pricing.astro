---
/**
 * pricing.astro
 * src/pages/pricing.astro
 */

import BaseLayout    from '../layouts/BaseLayout.astro';
import PricingCard   from '../components/PricingCard.astro';
import FaqAccordion  from '../components/FaqAccordion.astro';
import CtaBanner     from '../components/CtaBanner.astro';

const faqItems = [
  {
    question: 'Can I cancel my Professional subscription at any time?',
    answer:   'Yes. Cancel from your account settings at any time. Your subscription remains active until the end of the billing period. No cancellation fees.',
  },
  {
    question: 'Do you offer discounts for non-profits or co-operatives?',
    answer:   'Yes — registered NPOs and agricultural co-operatives can apply for a 50% discount. Email hello@tenderpreneurs.co.za with your NPO registration number.',
  },
  {
    question: 'Is my payment information secure?',
    answer:   'We never store your card details. All payments are processed by PayFast, a PCI-DSS compliant South African payment gateway. We receive only a tokenised confirmation.',
  },
  {
    question: "What happens to my saved tenders if I downgrade to Free?",
    answer:   'Your saved tenders are retained for 90 days. You can export them as a CSV before downgrading. After 90 days, the list is cleared.',
  },
  {
    question: 'Does Professional cover multiple users?',
    answer:   'Professional covers a single user. For team access, the Enterprise plan supports unlimited seats. Contact sales@tenderpreneurs.co.za for a quote.',
  },
];

const tableRows = [
  { feature: 'PFMA knowledge base (11 topics)',       free: true,  pro: true,  ent: true  },
  { feature: 'SBD form library',                      free: true,  pro: true,  ent: true  },
  { feature: 'Compliance checklist (CSD, Tax, B-BBEE)',free: true, pro: true,  ent: true  },
  { feature: 'PFMA AI Assistant (basic)',              free: true,  pro: true,  ent: true  },
  { feature: 'Live tender feed (7,841+ tenders)',      free: false, pro: true,  ent: true  },
  { feature: 'Province & sector filters',             free: false, pro: true,  ent: true  },
  { feature: 'Save searches + email alerts',          free: false, pro: true,  ent: true  },
  { feature: 'AI win-probability scoring',            free: false, pro: true,  ent: true  },
  { feature: 'B-BBEE preference calculator',          free: false, pro: true,  ent: true  },
  { feature: 'Tender document downloads',             free: false, pro: true,  ent: true  },
  { feature: 'Unlimited AI assistant queries',        free: false, pro: true,  ent: true  },
  { feature: 'Team seats',                            free: false, pro: false, ent: true  },
  { feature: 'API access',                            free: false, pro: false, ent: true  },
  { feature: 'Dedicated account manager',             free: false, pro: false, ent: true  },
  { feature: 'Custom tender alert rules',             free: false, pro: false, ent: true  },
  { feature: 'SLA & priority support',               free: false, pro: false, ent: true  },
];
---

<BaseLayout
  title="Pricing — Tenderpreneurs | Free PFMA Tools + Professional Tender Tracking"
  description="Free forever for PFMA research and compliance guidance. Upgrade to Professional (R299/mo) for live tender tracking, AI win-probability scoring, and email alerts."
  ogImage="/og-pricing.png"
>

  <!-- Page hero -->
  <section class="page-hero">
    <div class="wrap text-center">
      <div class="eyebrow eyebrow-center">Pricing</div>
      <h1 class="page-title">Simple, transparent pricing</h1>
      <p class="txt-secondary page-sub" style="margin:0 auto">
        Start free. Upgrade when you're ready to track live tenders.
      </p>
    </div>
  </section>

  <!-- Pricing cards -->
  <section class="section-sm">
    <div class="wrap">
      <div class="grid-3">
        <PricingCard
          plan="Free"
          price="R0"
          period="forever free"
          features={[
            'PFMA knowledge base (11 topics)',
            'SBD form library',
            'Compliance checklist',
            'PFMA AI Assistant (basic)',
            'CSD registration guide',
          ]}
          ctaLabel="Create free account"
          ctaHref="https://app.tenderpreneurs.co.za/register"
          ctaVariant="ghost"
        />
        <PricingCard
          plan="Professional"
          price="R299"
          period="per month"
          features={[
            'Everything in Free',
            'Live tender feed (7,841+ tenders)',
            'Province & sector filters',
            'Save searches + email alerts',
            'AI win-probability scoring',
            'B-BBEE preference calculator',
            'Tender document downloads',
            'Unlimited AI assistant queries',
          ]}
          ctaLabel="Start 14-day free trial"
          ctaHref="https://app.tenderpreneurs.co.za/register?plan=pro"
          ctaVariant="teal"
          featured={true}
        />
        <PricingCard
          plan="Enterprise"
          price="Custom"
          period="contact us"
          features={[
            'Everything in Professional',
            'Team seats (unlimited)',
            'API access',
            'Dedicated account manager',
            'Custom tender alert rules',
            'SLA & priority support',
            'Invoice billing',
          ]}
          ctaLabel="Contact sales"
          ctaHref="mailto:sales@tenderpreneurs.co.za"
          ctaVariant="ghost"
        />
      </div>
      <p class="txt-secondary text-center mt-6 text-xs">
        Payments processed securely via <strong class="txt-primary">PayFast</strong> ·
        Cancel anytime — no lock-in contracts
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- Feature comparison table -->
  <section class="section-sm">
    <div class="wrap">
      <div class="eyebrow">Full comparison</div>
      <h2>Everything included in each plan</h2>

      <div class="compare-table-wrap mt-8">
        <table class="compare-table" aria-label="Plan feature comparison">
          <thead>
            <tr>
              <th class="th-feature">Feature</th>
              <th>Free</th>
              <th>
                Professional
                <span class="th-badge">Popular</span>
              </th>
              <th>Enterprise</th>
            </tr>
          </thead>
          <tbody>
            {tableRows.map(row => (
              <tr>
                <td class="td-feature">{row.feature}</td>
                <td class="td-check">
                  {row.free
                    ? <span class="check-yes" aria-label="Included">✓</span>
                    : <span class="check-no"  aria-label="Not included">–</span>
                  }
                </td>
                <td class="td-check">
                  {row.pro
                    ? <span class="check-yes" aria-label="Included">✓</span>
                    : <span class="check-no"  aria-label="Not included">–</span>
                  }
                </td>
                <td class="td-check">
                  {row.ent
                    ? <span class="check-yes" aria-label="Included">✓</span>
                    : <span class="check-no"  aria-label="Not included">–</span>
                  }
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- FAQ -->
  <section class="section-sm">
    <div class="wrap">
      <div class="eyebrow">FAQ</div>
      <h2>Common pricing questions</h2>
      <div class="faq-wrap mt-8">
        <FaqAccordion items={faqItems} />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    eyebrow="No credit card needed"
    heading={`Start free, upgrade<br><span class="txt-gold">when you're ready</span>`}
    body="Create your free account today and access the full PFMA knowledge base instantly."
    primaryLabel="Get Started Free"
    primaryHref="https://app.tenderpreneurs.co.za/register"
    secondLabel="Contact sales"
    secondHref="mailto:sales@tenderpreneurs.co.za"
  />

</BaseLayout>

<style>
.page-hero {
  padding: calc(var(--nav-h) + var(--safe-t) + var(--sp-12)) 0 var(--sp-10);
  border-bottom: 1px solid var(--brd);
}
.page-title { margin-bottom: var(--sp-3); }
.page-sub   { font-size: 1rem; max-width: 460px; line-height: 1.7; }

/* Comparison table */
.compare-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border:        1px solid var(--brd);
  border-radius: var(--r-lg);
}

.compare-table {
  width:           100%;
  border-collapse: collapse;
  font-size:       .875rem;
  min-width:       560px;
}

.compare-table thead tr {
  background:    var(--srf-1);
  border-bottom: 1px solid var(--brd);
}

.compare-table th {
  padding:    var(--sp-4) var(--sp-5);
  font-size:  .8125rem;
  font-weight: 700;
  color:      var(--txt-primary);
  text-align: center;
  white-space: nowrap;
  position:   relative;
}
.th-feature { text-align: left; width: 50%; }

.th-badge {
  display:       inline-block;
  margin-left:   var(--sp-2);
  background:    var(--clr-teal);
  color:         var(--txt-inverse);
  font-size:     10px;
  padding:       1px 6px;
  border-radius: var(--r-full);
  vertical-align: middle;
}

.compare-table tbody tr {
  border-bottom: 1px solid var(--brd);
  transition:    background .12s;
}
.compare-table tbody tr:last-child { border-bottom: none; }
.compare-table tbody tr:hover      { background: rgba(255,255,255,.03); }

.td-feature {
  padding:    var(--sp-3) var(--sp-5);
  color:      var(--txt-secondary);
  text-align: left;
}
.td-check {
  padding:    var(--sp-3) var(--sp-5);
  text-align: center;
}

.check-yes { color: var(--clr-teal); font-size: 1rem; font-weight: 700; }
.check-no  { color: var(--txt-tertiary); font-size: .875rem; }

.faq-wrap { max-width: 680px; }
</style>
