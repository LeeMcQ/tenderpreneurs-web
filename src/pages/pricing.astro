---
// src/pages/pricing.astro
// Pricing page with honest feature labels. Every advertised capability
// is sourced from src/config/site.ts so claims stay consistent everywhere.

import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { CTA, FEATURES } from "../config/site";

const title = "Pricing — Tenderpreneur | Free PFMA Tools + Professional Tender Tracking";
const description =
  "Free forever for PFMA research and compliance guidance. Upgrade to Professional (R299/mo + VAT) once the live tender feed and AI scoring go live.";

// Group features by plan tier for the comparison table.
// Each row carries its own status badge so we never overpromise.
const freePlan = [
  FEATURES.pfmaKnowledgeBase,
  FEATURES.sbdFormLibrary,
  FEATURES.complianceChecklist,
  FEATURES.pfmaAssistant,
];

const proPlan = [
  FEATURES.liveTenderFeed,
  FEATURES.provinceFilters,
  FEATURES.emailAlerts,
  FEATURES.winProbability,
  FEATURES.bbbeeCalculator,
  FEATURES.documentDownloads,
  FEATURES.unlimitedAssistant,
];

const enterprisePlan = [
  FEATURES.teamSeats,
  FEATURES.apiAccess,
];
---

<BaseLayout title={title} description={description}>
  <main id="main-content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">Pricing</li>
      </ol>
    </nav>

    <header class="pricing-hero">
      <h1>Simple, transparent pricing</h1>
      <p class="lede">
        Start free. Upgrade when the live tender feed launches. We label every feature
        <strong>Live</strong>, <strong>Beta</strong>, or <strong>Coming soon</strong> —
        because we'd rather lose a signup than mislead a buyer.
      </p>
    </header>

    <section class="plans-grid" aria-label="Pricing plans">
      <!-- FREE -->
      <article class="plan">
        <header>
          <span class="plan-icon" aria-hidden="true">📦</span>
          <h2>Free</h2>
          <p class="price"><strong>R0</strong> <span>forever</span></p>
          <p class="plan-pitch">Everything you need to get procurement-ready.</p>
        </header>
        <ul class="plan-features">
          {freePlan.map((f) => (
            <li>
              <span class="check" aria-hidden="true">✓</span>
              <span class="feat-name">{f.label}</span>
              <StatusBadge status={f.status} eta={f.eta} />
            </li>
          ))}
        </ul>
        <a href={CTA.signup} class="plan-cta plan-cta-secondary">Create free account</a>
      </article>

      <!-- PROFESSIONAL -->
      <article class="plan plan-featured">
        <div class="plan-badge">Most popular when live</div>
        <header>
          <span class="plan-icon" aria-hidden="true">⚡</span>
          <h2>Professional</h2>
          <p class="price"><strong>R299</strong> <span>per month + VAT</span></p>
          <p class="plan-pitch">For SMMEs actively pursuing government tenders.</p>
        </header>
        <ul class="plan-features">
          <li class="includes">Everything in Free, plus:</li>
          {proPlan.map((f) => (
            <li>
              <span class="check" aria-hidden="true">✓</span>
              <span class="feat-name">{f.label}</span>
              <StatusBadge status={f.status} eta={f.eta} />
            </li>
          ))}
        </ul>
        <a href={CTA.signupPro} class="plan-cta plan-cta-primary">Join the Pro waitlist</a>
        <p class="plan-footnote">
          We'll only start your subscription once the live tender feed and AI scoring are
          ready. No charge until then.
        </p>
      </article>

      <!-- ENTERPRISE -->
      <article class="plan">
        <header>
          <span class="plan-icon" aria-hidden="true">🏢</span>
          <h2>Enterprise</h2>
          <p class="price"><strong>Custom</strong> <span>contact us</span></p>
          <p class="plan-pitch">For procurement teams, advisors, and large suppliers.</p>
        </header>
        <ul class="plan-features">
          <li class="includes">Everything in Professional, plus:</li>
          {enterprisePlan.map((f) => (
            <li>
              <span class="check" aria-hidden="true">✓</span>
              <span class="feat-name">{f.label}</span>
              <StatusBadge status={f.status} eta={f.eta} />
            </li>
          ))}
          <li>
            <span class="check" aria-hidden="true">✓</span>
            <span class="feat-name">Dedicated account manager</span>
            <StatusBadge status="live" />
          </li>
          <li>
            <span class="check" aria-hidden="true">✓</span>
            <span class="feat-name">SLA &amp; priority support</span>
            <StatusBadge status="live" />
          </li>
          <li>
            <span class="check" aria-hidden="true">✓</span>
            <span class="feat-name">Invoice billing</span>
            <StatusBadge status="live" />
          </li>
        </ul>
        <a href={CTA.signupEnterprise} class="plan-cta plan-cta-secondary">Contact sales</a>
      </article>
    </section>

    <p class="payments-note">
      Payments processed securely via <a href="https://www.payfast.co.za" rel="noopener">PayFast</a>.
      Cancel anytime — no lock-in contracts. Prices exclude VAT.
    </p>

    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Frequently asked questions</h2>

      <details>
        <summary>Why are so many features marked "Coming soon"?</summary>
        <p>
          We're a young South African company shipping in public. We'd rather list every
          planned feature with an honest status than hide what's not built yet. Today, the
          free PFMA Knowledge Base and AI Assistant (beta) are usable. The tender feed and
          AI scoring are in active development — join the waitlist on the
          <a href="/tenders">Tenders</a> page for launch updates.
        </p>
      </details>

      <details>
        <summary>Will my Professional subscription start before the live feed is ready?</summary>
        <p>
          No. If you sign up for Professional today, you join the waitlist. We only
          begin billing once the core Pro features (live tender feed, win-probability
          scoring, B-BBEE calculator) are out of "coming soon" and into "live".
        </p>
      </details>

      <details>
        <summary>Can I cancel my Professional subscription at any time?</summary>
        <p>
          Yes. Cancel from your account settings at any time. Your subscription remains
          active until the end of the billing period. No cancellation fees.
        </p>
      </details>

      <details>
        <summary>Do you offer discounts for non-profits or co-operatives?</summary>
        <p>
          Yes — registered NPOs and agricultural co-operatives can apply for a 50%
          discount. Email <a href="mailto:hello@tenderpreneur.co.za">hello@tenderpreneur.co.za</a>
          with your NPO registration number.
        </p>
      </details>

      <details>
        <summary>Is my payment information secure?</summary>
        <p>
          We never store your card details. All payments are processed by PayFast, a
          PCI-DSS compliant South African payment gateway. We receive only a tokenised
          confirmation.
        </p>
      </details>

      <details>
        <summary>What happens to my saved tenders if I downgrade to Free?</summary>
        <p>
          Your saved tenders are retained for 90 days. You can export them as a CSV
          before downgrading. After 90 days, the list is cleared.
        </p>
      </details>

      <details>
        <summary>Does Professional cover multiple users?</summary>
        <p>
          Professional covers a single user. For team access, the Enterprise plan supports
          unlimited seats. Contact <a href="mailto:sales@tenderpreneur.co.za">sales@tenderpreneur.co.za</a>
          for a quote.
        </p>
      </details>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 20px 80px;
  }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: #6b7280;
  }
  .breadcrumb a { color: #0C1B33; }
  .pricing-hero {
    text-align: center;
    padding: 24px 0 40px;
  }
  .pricing-hero h1 {
    font-size: clamp(28px, 5vw, 42px);
    margin: 0 0 12px;
    color: #0C1B33;
  }
  .lede {
    font-size: 17px;
    color: #4b5563;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.5;
  }
  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 16px;
    align-items: start;
  }
  .plan {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 28px;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .plan-featured {
    border: 2px solid #0C1B33;
    box-shadow: 0 4px 20px rgba(12, 27, 51, 0.08);
  }
  .plan-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #0C1B33;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .plan-icon { font-size: 28px; }
  .plan h2 {
    margin: 8px 0 4px;
    font-size: 22px;
    color: #0C1B33;
  }
  .price {
    margin: 4px 0 8px;
    color: #6b7280;
    font-size: 14px;
  }
  .price strong {
    font-size: 32px;
    color: #0C1B33;
    font-weight: 700;
  }
  .plan-pitch {
    color: #4b5563;
    font-size: 14px;
    margin: 0 0 20px;
    min-height: 40px;
  }
  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    gap: 10px;
    flex: 1;
  }
  .plan-features li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: #1f2937;
    line-height: 1.4;
  }
  .plan-features .includes {
    font-weight: 600;
    color: #0C1B33;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 8px;
    margin-bottom: 4px;
  }
  .check {
    color: #10b981;
    font-weight: 700;
    width: 16px;
  }
  .feat-name { flex: 1; }
  .plan-cta {
    display: block;
    text-align: center;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    margin-top: auto;
  }
  .plan-cta-primary { background: #0C1B33; color: #fff; }
  .plan-cta-secondary { background: transparent; color: #0C1B33; border: 1px solid #0C1B33; }
  .plan-cta-primary:hover { opacity: 0.92; }
  .plan-cta-secondary:hover { background: rgba(12, 27, 51, 0.05); }
  .plan-footnote {
    margin-top: 10px;
    font-size: 12px;
    color: #6b7280;
    text-align: center;
  }
  .payments-note {
    text-align: center;
    color: #6b7280;
    font-size: 14px;
    margin: 32px 0 56px;
  }
  .payments-note a { color: #0C1B33; }
  .faq {
    max-width: 720px;
    margin: 0 auto;
  }
  .faq h2 {
    text-align: center;
    margin: 0 0 24px;
    color: #0C1B33;
  }
  .faq details {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 16px 20px;
    margin-bottom: 10px;
  }
  .faq summary {
    font-weight: 600;
    color: #0C1B33;
    cursor: pointer;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: "+";
    float: right;
    font-weight: 400;
    font-size: 18px;
    color: #6b7280;
  }
  .faq details[open] summary::after { content: "−"; }
  .faq p {
    margin: 12px 0 0;
    color: #4b5563;
    line-height: 1.6;
  }
  .faq a { color: #0C1B33; }
</style>
