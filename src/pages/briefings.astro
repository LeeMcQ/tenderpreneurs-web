---
import BaseLayout from '../layouts/BaseLayout.astro';
import { peekEnv } from '../lib/db';
import { displayTitle, provinceLabel } from '../lib/tender-display';

export const prerender = false;

let rows: any[] = [];
let ok = false;
try {
  const env = peekEnv(Astro);
  if (env?.DB) {
    const res = await env.DB.prepare(
      `SELECT id, title, source_ref, procuring_entity, province, briefing_date,
              briefing_compulsory, briefing_location, closing_date
       FROM tenders
       WHERE status = 'open' AND canonical_ref IS NULL
         AND briefing_date IS NOT NULL
         AND date(briefing_date) >= date('now')
       ORDER BY date(briefing_date) ASC
       LIMIT 80`,
    ).all();
    rows = (res as any).results || [];
    ok = true;
  }
} catch {}

const groups = new Map<string, any[]>();
for (const row of rows) {
  const day = String(row.briefing_date).slice(0, 10);
  if (!groups.has(day)) groups.set(day, []);
  groups.get(day)!.push(row);
}
---
<BaseLayout title="Briefing calendar | Tenderpreneurs" description="Upcoming site briefings on open South African government tenders.">
  <div class="cal">
    <p class="kicker">Do not miss a compulsory briefing</p>
    <h1>Briefing calendar</h1>
    <p class="lede">Dates taken from published notices. Closing dates stay public. Always confirm venue and time on the official pack — they move. See <a href="/coverage">source coverage</a>.</p>
    {!ok && <p class="empty">Calendar unavailable while the catalogue is offline.</p>}
    {ok && !rows.length && <p class="empty">No upcoming briefings recovered on open notices.</p>}
    {[...groups.entries()].map(([day, items]) => (
      <section>
        <h2>{day}</h2>
        <ul>
          {items.map((t) => (
            <li>
              <a href={`/tenders/t/${t.id}`}>
                <strong>{displayTitle(t)}</strong>
                <span>
                  {t.briefing_compulsory ? 'Compulsory' : 'Optional'}
                  {t.briefing_location ? ` · ${t.briefing_location}` : ''}
                  {t.province ? ` · ${provinceLabel(t.province)}` : ''}
                  {t.closing_date ? ` · closes ${String(t.closing_date).slice(0, 10)}` : ''}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
<style>
  .cal { max-width: 840px; margin: 0 auto; padding: 28px 20px 80px; color: #e2e8f0; }
  .kicker { text-transform: uppercase; letter-spacing: .08em; font-size: 12px; color: #d97706; margin: 0; }
  h1 { font-size: clamp(28px, 4vw, 40px); margin: 6px 0 12px; color: #fff; }
  .lede, .empty { color: #94a3b8; max-width: 68ch; }
  section { margin-top: 28px; }
  h2 { font-size: 16px; color: #fbbf24; margin: 0 0 10px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  a { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; background: #0f1c33; border: 1px solid rgba(255,255,255,.08); border-radius: 12px; color: inherit; text-decoration: none; min-height: 44px; }
  a strong { color: #fff; }
  a span { font-size: 13px; color: #94a3b8; }
</style>
