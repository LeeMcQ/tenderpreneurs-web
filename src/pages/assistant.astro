---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Tender creation assistant | Tenderpreneurs';
const description = 'Create a notice from a previous tender or RFQ, or review a draft or published link for gaps and loopholes.';
---
<BaseLayout title={title} description={description}>
  <main class="wrap" style="padding:48px 20px 80px;max-width:880px;margin:0 auto">
    <p class="eyebrow">For procuring entities</p>
    <h1>Tender creation assistant</h1>
    <p class="txt-secondary" style="max-width:62ch;line-height:1.6">
      Two tools. Neither is the supplier catalogue. Briefings and what we could read on a notice sit on the tender page, not here.
    </p>
    <div class="grid-2" style="display:grid;gap:16px;margin-top:28px">
      <a href="/create" style="display:block;padding:20px;border:1px solid rgba(255,255,255,.12);border-radius:14px">
        <h2>Create a draft</h2>
        <p>Upload a previous tender or RFQ. We copy the shape your organisation already uses, then you fill this notice.</p>
      </a>
      <a href="/review" style="display:block;padding:20px;border:1px solid rgba(255,255,255,.12);border-radius:14px">
        <h2>Review a draft</h2>
        <p>Upload what you have written, or give a link to a published tender. We flag missing items, exploitable wording, and fixes.</p>
      </a>
    </div>
  </main>
</BaseLayout>
