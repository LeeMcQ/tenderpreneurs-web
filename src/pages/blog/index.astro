---
import { getCollection } from 'astro:content';
import { format } from 'date-fns';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog – tenderpreneurs</title>
    <meta
      name="description"
      content="Insights, guides, and news on South African government tenders and procurement."
    />
  </head>
  <body>
    <main class="max-w-7xl mx-auto px-4 py-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Blog</h1>
      <p class="text-lg text-gray-600 mb-12">
        Expert advice for winning more government contracts.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="block bg-white rounded-2xl shadow hover:shadow-lg transition p-6 border border-gray-100"
          >
            <span class="text-sm text-gray-500">
              {format(post.data.date, 'd MMM yyyy')}
            </span>
            <h2 class="text-xl font-semibold text-gray-900 mt-1 mb-2">
              {post.data.title}
            </h2>
            <p class="text-gray-600 line-clamp-3">{post.data.description}</p>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>