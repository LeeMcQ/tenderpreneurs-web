---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SEO from '@components/SEO.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

// Pagination — 9 per page for now (extend with paginate() if needed)
const page = 1;
const perPage = 9;
const paginated = posts.slice(0, perPage);
const totalPages = Math.ceil(posts.length / perPage);

const seoData = {
  title: 'Blog — South African Government Tender Guides & PFMA Insights | Tenderpreneur',
  description:
    'Practical guides on CSD registration, B-BBEE, PFMA compliance, tender pricing, and winning strategies for South African SMMEs.',
  canonical: 'https://tenderpreneur.co.za/blog',
  ogImage: 'https://tenderpreneur.co.za/og-blog.png',
};

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-ZA', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(date));
}
---

<BaseLayout>
  <SEO slot="head" {...seoData} />

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-navy-900 to-civic-800 py-20 text-white">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="breadcrumb mb-6">
        <ol class="flex items-center gap-2 text-sm text-sky-300">
          <li><a href="/" class="hover:text-white">Home</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page" class="text-white">Blog</li>
        </ol>
      </nav>
      <h1 class="font-display text-4xl font-bold text-white sm:text-5xl">
        Tender intelligence blog
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-sky-200">
        Practical guides on PFMA, B-BBEE, CSD, tender pricing, and winning strategies —
        written for South African SMMEs.
      </p>
      <a
        href="/blog/rss.xml"
        class="mt-4 inline-flex items-center gap-2 text-sm text-sky-300 hover:text-white"
        aria-label="Subscribe to RSS feed"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
        RSS feed
      </a>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="bg-white py-16 dark:bg-navy-950" aria-labelledby="posts-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 id="posts-heading" class="sr-only">Blog posts</h2>

      {
        posts.length === 0 ? (
          <p class="text-center text-gray-500">No posts yet. Check back soon.</p>
        ) : (
          <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {paginated.map((post) => (
              <article class="card group flex flex-col">
                <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
                  <time datetime={new Date(post.data.pubDate).toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                  {post.data.category && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span class="badge badge-blue">{post.data.category}</span>
                    </>
                  )}
                </div>
                <h2 class="mt-3 font-display text-lg font-semibold leading-snug text-navy-900 group-hover:text-civic-700 dark:text-white dark:group-hover:text-sky-400">
                  <a
                    href={`/blog/${post.slug}`}
                    class="focus-visible:outline-none focus-visible:underline"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2 flex-1 text-sm text-gray-600 dark:text-gray-300 line-clamp-3">
                  {post.data.description}
                </p>
                <div class="mt-4 flex items-center justify-between">
                  <span class="text-xs text-gray-500">{post.data.author}</span>
                  <a
                    href={`/blog/${post.slug}`}
                    class="text-sm font-medium text-civic-600 hover:underline dark:text-sky-400"
                    aria-label={`Read ${post.data.title}`}
                  >
                    Read more →
                  </a>
                </div>
              </article>
            ))}
          </div>
        )
      }

      <!-- Pagination -->
      {
        totalPages > 1 && (
          <nav
            class="mt-12 flex items-center justify-center gap-4"
            aria-label="Blog pagination"
          >
            <span class="text-sm text-gray-500">
              Page {page} of {totalPages}
            </span>
            {page < totalPages && (
              <a
                href={`/blog/page/2`}
                class="btn-secondary"
              >
                Next page →
              </a>
            )}
          </nav>
        )
      }
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="bg-sky-50 py-16 dark:bg-navy-900" aria-labelledby="newsletter-heading">
    <div class="mx-auto max-w-xl px-4 text-center sm:px-6">
      <h2
        id="newsletter-heading"
        class="font-display text-2xl font-bold text-navy-900 dark:text-white"
      >
        Get tender tips in your inbox
      </h2>
      <p class="mt-2 text-gray-600 dark:text-gray-300">
        Weekly guides on procurement, compliance, and winning strategies for SA SMMEs.
      </p>
      <form
        class="mt-6 flex flex-col gap-3 sm:flex-row"
        action="https://app.tenderpreneur.co.za/newsletter"
        method="POST"
        aria-label="Newsletter signup"
      >
        <label for="email-blog" class="sr-only">Email address</label>
        <input
          id="email-blog"
          type="email"
          name="email"
          required
          placeholder="your@email.co.za"
          class="flex-1 rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-civic-500 focus:ring-2 focus:ring-civic-200 dark:border-navy-600 dark:bg-navy-800 dark:text-white"
        />
        <button type="submit" class="btn-primary whitespace-nowrap">
          Subscribe free
        </button>
      </form>
      <p class="mt-2 text-xs text-gray-400">No spam. POPIA compliant. Unsubscribe anytime.</p>
    </div>
  </section>
</BaseLayout>
