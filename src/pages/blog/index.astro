---
/**
 * blog/index.astro
 * src/pages/blog/index.astro
 *
 * Blog listing page — shows all articles.
 * In production, replace the static `posts` array with:
 *   const posts = await getCollection('blog');
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard   from '../../components/BlogCard.astro';
import CtaBanner  from '../../components/CtaBanner.astro';

type TagVariant = 'teal' | 'gold';
interface BlogPost {
  href: string; tag: string; tagVariant: TagVariant; emoji: string;
  thumbBg: string; title: string; excerpt: string; readTime: string; date: string;
}

const posts: BlogPost[] = [
  {
    href:       '/blog/how-to-win-your-first-government-tender',
    tag:        'Beginners',
    tagVariant: 'gold',
    emoji:      '🏆',
    thumbBg:    'linear-gradient(135deg,#0F2140,#1C3566)',
    title:      'How to Win Your First Government Tender in South Africa',
    excerpt:    'A step-by-step guide for newcomers, covering everything from finding the right opportunities to submitting a compliant bid that survives evaluation.',
    readTime:   '8 min read',
    date:       '12 Mar 2026',
  },
  {
    href:       '/blog/understanding-bbbee-requirements',
    tag:        'Compliance',
    tagVariant: 'teal',
    emoji:      '📊',
    thumbBg:    'linear-gradient(135deg,#0F2140,#0A1E30)',
    title:      'Understanding B-BBEE Requirements for Tenders',
    excerpt:    'Learn how your B-BBEE scorecard affects your tender competitiveness and what documentation you need to submit with your bid.',
    readTime:   '6 min read',
    date:       '10 Mar 2026',
  },
  {
    href:       '/blog/central-supplier-database-registration',
    tag:        'Compliance',
    tagVariant: 'teal',
    emoji:      '🗂️',
    thumbBg:    'linear-gradient(135deg,#081525,#0F2140)',
    title:      'Central Supplier Database Registration: A Complete Walkthrough',
    excerpt:    'Everything you need to know to register on the CSD, from required documents to bank account verification and avoiding common mistakes that cause delays.',
    readTime:   '10 min read',
    date:       '10 Mar 2026',
  },
];
---

<BaseLayout
  title="Blog — Tenderpreneurs | Procurement Guides & Insights"
  description="Expert advice for winning more government contracts. Guides on tendering, B-BBEE, CSD registration, PFMA compliance and more."
  ogImage="/og-blog.png"
>

  <!-- Page header -->
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Resources</div>
      <h1 class="page-title">Procurement guides<br>&amp; insights</h1>
      <p class="txt-secondary page-sub">
        Expert advice for winning more government contracts.
      </p>
    </div>
  </section>

  <!-- Posts grid -->
  <section class="section-sm">
    <div class="wrap">
      <div class="grid-3">
        {posts.map(p => <BlogCard {...p} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    eyebrow="Put it into practice"
    heading='Browse <span class="txt-gold">live tenders</span> right now'
    body="7,841+ government tenders from all 9 provinces, updated every 4 hours. Free to browse — sign in to save and get alerts."
    primaryLabel="Browse Live Tenders"
    primaryHref="/tenders"
    secondLabel="Get Started Free"
    secondHref="'https://app\.tenderpreneurs\.co\.za/register', '/auth/login'"
  />

</BaseLayout>

<style>
.page-hero {
  padding: calc(var(--nav-h) + var(--safe-t) + var(--sp-12)) 0 var(--sp-10);
  border-bottom: 1px solid var(--brd);
}
.page-title {
  font-size:     clamp(1.75rem, 5vw, 2.75rem);
  margin-bottom: var(--sp-3);
  line-height:   1.15;
}
.page-sub {
  font-size:  1rem;
  max-width:  480px;
  line-height: 1.7;
}
</style>
