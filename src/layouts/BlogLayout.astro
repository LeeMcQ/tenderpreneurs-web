---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';

export interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  modifiedDate?: Date;
  author?: string;
  tags?: string[];
  category?: string;
  slug: string;
  ogImage?: string;
  readingTime?: number;
  relatedSlugs?: string[];
}

const {
  title,
  description,
  publishedDate,
  modifiedDate,
  author = 'Tenderpreneur Editorial',
  tags = [],
  category = 'Procurement',
  slug,
  ogImage,
  readingTime,
  relatedSlugs = [],
} = Astro.props;

const canonicalUrl = `https://tenderpreneur.co.za/blog/${slug}`;
const formattedDate = publishedDate.toLocaleDateString('en-ZA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = publishedDate.toISOString();
const isoModified = (modifiedDate ?? publishedDate).toISOString();

// Fetch related posts
let relatedPosts: any[] = [];
try {
  const allPosts = await getCollection('blog');
  if (relatedSlugs.length > 0) {
    relatedPosts = allPosts.filter((p) => relatedSlugs.includes(p.slug)).slice(0, 3);
  } else {
    relatedPosts = allPosts
      .filter((p) => p.slug !== slug)
      .sort(() => Math.random() - 0.5)
      .slice(0, 3);
  }
} catch (e) {
  relatedPosts = [];
}

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonicalUrl,
  datePublished: isoDate,
  dateModified: isoModified,
  author: {
    '@type': 'Organization',
    name: author,
    url: 'https://tenderpreneur.co.za',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Tenderpreneur',
    url: 'https://tenderpreneur.co.za',
    logo: {
      '@type': 'ImageObject',
      url: 'https://tenderpreneur.co.za/logo.png',
    },
  },
  image: ogImage ?? 'https://tenderpreneur.co.za/og-default.jpg',
  articleSection: category,
  keywords: tags.join(', '),
  inLanguage: 'en-ZA',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://tenderpreneur.co.za' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://tenderpreneur.co.za/blog' },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="article"
  publishedTime={isoDate}
  modifiedTime={isoModified}
  author={author}
  section={category}
  schema={[blogPostingSchema, breadcrumbSchema]}
>
  <div class="blog-layout">
    <div class="container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb py-4" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <a href="/blog">Blog</a>
        <span class="breadcrumb-sep" aria-hidden="true">›</span>
        <span aria-current="page">{title}</span>
      </nav>

      <div class="blog-content-grid">
        <!-- Main article -->
        <article class="blog-article" itemscope itemtype="https://schema.org/BlogPosting">
          <header class="blog-header">
            {category && (
              <div class="blog-category">
                <span class="badge badge-civic">{category}</span>
              </div>
            )}

            <h1 class="blog-title" itemprop="headline">{title}</h1>
            <p class="blog-description">{description}</p>

            <div class="blog-meta">
              <div class="blog-meta-author">
                <div class="author-avatar" aria-hidden="true">
                  {author.charAt(0)}
                </div>
                <div>
                  <div class="author-name" itemprop="author">{author}</div>
                  <div class="blog-date">
                    <time datetime={isoDate} itemprop="datePublished">{formattedDate}</time>
                    {readingTime && <span>· {readingTime} min read</span>}
                  </div>
                </div>
              </div>
              {tags.length > 0 && (
                <div class="blog-tags">
                  {tags.map((tag) => (
                    <span class="blog-tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </header>

          <div class="prose-tp blog-body" itemprop="articleBody">
            <slot />
          </div>

          <!-- Email Signup CTA -->
          <aside class="blog-cta" aria-label="Newsletter signup">
            <div class="blog-cta-inner">
              <div class="blog-cta-icon" aria-hidden="true">📬</div>
              <div>
                <h3 class="blog-cta-title">Get tender alerts to your inbox</h3>
                <p class="blog-cta-text">Stay ahead of closing dates. Free for South African SMMEs.</p>
              </div>
            </div>
            <form class="blog-cta-form" action="https://app.tenderpreneur.co.za/signup" method="GET" novalidate>
              <label for="email-cta" class="sr-only">Email address</label>
              <input
                id="email-cta"
                type="email"
                name="email"
                placeholder="you@company.co.za"
                class="blog-cta-input"
                autocomplete="email"
                required
              />
              <button type="submit" class="btn btn-primary">Get Started Free</button>
            </form>
          </aside>
        </article>

        <!-- Sidebar -->
        <aside class="blog-sidebar" aria-label="Related articles">
          <div class="sidebar-sticky">
            <h3 class="sidebar-heading">Related Articles</h3>
            {relatedPosts.length > 0 ? (
              <ul class="sidebar-list" role="list">
                {relatedPosts.map((post) => (
                  <li class="sidebar-item">
                    <a href={`/blog/${post.slug}`} class="sidebar-link">
                      <span class="sidebar-link-title">{post.data.title}</span>
                      <span class="sidebar-link-date">
                        {post.data.publishedDate?.toLocaleDateString('en-ZA', { month: 'short', day: 'numeric', year: 'numeric' })}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-gray-500">No related articles yet.</p>
            )}

            <div class="sidebar-pfma-box">
              <h4 class="sidebar-pfma-title">📚 PFMA Reference Guide</h4>
              <p class="sidebar-pfma-text">Navigate PFMA, Treasury Regs, B-BBEE and SCM with our comprehensive guides.</p>
              <a href="/pfma" class="btn btn-outline text-sm mt-3 w-full">Explore PFMA Guides</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-layout {
    background: var(--color-surface-2, #F8FAFC);
    padding-bottom: 4rem;
  }

  .blog-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .blog-content-grid {
      grid-template-columns: 1fr 320px;
    }
  }

  .blog-article {
    background: var(--color-surface);
    border-radius: 1rem;
    padding: 2.5rem;
    box-shadow: var(--shadow-card);
  }

  @media (min-width: 640px) {
    .blog-article {
      padding: 3rem;
    }
  }

  .blog-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-category {
    margin-bottom: 1rem;
  }

  .blog-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--color-navy, #0C1B33);
    line-height: 1.2;
    margin-bottom: 0.875rem;
  }

  .blog-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .blog-meta-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1B4F8A, #3B82F6);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .author-name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .blog-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    display: flex;
    gap: 0.25rem;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .blog-tag {
    padding: 0.25rem 0.75rem;
    background: var(--color-sky, #DBEAFE);
    color: #1B4F8A;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .blog-body {
    min-height: 400px;
  }

  .blog-cta {
    margin-top: 3rem;
    background: linear-gradient(135deg, #0C1B33, #1B4F8A);
    border-radius: 1rem;
    padding: 2rem;
    color: white;
  }

  .blog-cta-inner {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .blog-cta-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .blog-cta-title {
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.375rem;
  }

  .blog-cta-text {
    font-size: 0.875rem;
    color: rgba(219, 234, 254, 0.8);
  }

  .blog-cta-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .blog-cta-input {
    flex: 1;
    min-width: 200px;
    padding: 0.625rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.08);
    color: white;
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .blog-cta-input::placeholder {
    color: rgba(219, 234, 254, 0.5);
  }

  .blog-cta-input:focus {
    border-color: rgba(217, 119, 6, 0.6);
    background: rgba(255,255,255,0.12);
  }

  /* Sidebar */
  .blog-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .blog-sidebar {
      display: block;
    }
  }

  .sidebar-sticky {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sidebar-item {
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 0;
    text-decoration: none;
    transition: color 0.15s;
  }

  .sidebar-link:hover .sidebar-link-title {
    color: #1B4F8A;
  }

  .sidebar-link-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    transition: color 0.15s;
  }

  .sidebar-link-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .sidebar-pfma-box {
    background: linear-gradient(135deg, #0C1B33, #1B4F8A);
    border-radius: 0.875rem;
    padding: 1.25rem;
    color: white;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-pfma-title {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .sidebar-pfma-text {
    font-size: 0.8125rem;
    color: rgba(219, 234, 254, 0.8);
    line-height: 1.5;
  }
</style>
