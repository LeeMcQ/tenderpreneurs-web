---
/**
 * BlogLayout.astro
 * src/layouts/BlogLayout.astro
 *
 * Layout wrapper for individual blog/article pages.
 *
 * Props — passed from MDX/Markdown frontmatter:
 *   title      — article title
 *   description — meta description / excerpt
 *   tag        — category label ('Beginners' | 'Compliance' | 'Bidding' | …)
 *   tagVariant — 'gold' | 'teal'
 *   date       — publication date string e.g. '12 March 2026'
 *   readTime   — e.g. '8 min read'
 *   author     — author name (default: 'Tenderpreneurs Team')
 *   ogImage    — og image path (optional)
 */

import BaseLayout from './BaseLayout.astro';
import CtaBanner  from '../components/CtaBanner.astro';

interface Props {
  title:       string;
  description: string;
  tag:         string;
  tagVariant?: 'gold' | 'teal';
  date:        string;
  readTime:    string;
  author?:     string;
  ogImage?:    string;
}

const {
  title,
  description,
  tag,
  tagVariant = 'teal',
  date,
  readTime,
  author   = 'Tenderpreneurs Team',
  ogImage,
} = Astro.props;
---

<BaseLayout {title} {description} ogImage={ogImage ?? '/og-blog.png'}>

  <!-- Article header -->
  <header class="post-header">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/blog">Blog</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{title}</span>
      </nav>

      <span class={`tag tag-${tagVariant} post-tag`}>{tag}</span>
      <h1 class="post-title">{title}</h1>
      <p class="txt-secondary post-desc">{description}</p>

      <div class="post-meta mono txt-tertiary">
        <span>{author}</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <time datetime={date}>{date}</time>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span>{readTime}</span>
      </div>
    </div>
  </header>

  <div class="divider"></div>

  <!-- Article body -->
  <article class="post-body">
    <div class="wrap">
      <div class="prose prose-constrained">
        <slot />
      </div>

      <!-- Back link -->
      <a href="/blog" class="back-link">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M13 8H3M7 4l-4 4 4 4"/>
        </svg>
        Back to all articles
      </a>
    </div>
  </article>

  <!-- CTA -->
  <CtaBanner
    eyebrow="Ready to apply this?"
    heading='Find relevant tenders<br><span class="txt-gold">right now</span>'
    body="Browse 7,841+ live government tenders — filtered, scored, and updated every 4 hours. Free to start."
    primaryLabel="Browse Live Tenders"
    primaryHref="/tenders"
    secondLabel="Get Started Free"
    secondHref="https://app.tenderpreneurs.co.za/register"
  />

</BaseLayout>

<style>
.post-header {
  padding: calc(var(--nav-h) + var(--safe-t) + var(--sp-10)) 0 var(--sp-10);
}

.breadcrumb {
  display:       flex;
  align-items:   center;
  gap:           var(--sp-2);
  flex-wrap:     wrap;
  font-size:     .8125rem;
  color:         var(--txt-secondary);
  margin-bottom: var(--sp-5);
}
.breadcrumb a           { color: var(--clr-teal); transition: color .15s; }
.breadcrumb a:hover     { color: var(--clr-teal-2); }
.breadcrumb span[aria-hidden] { color: var(--txt-tertiary); }

.post-tag    { margin-bottom: var(--sp-4); display: inline-block; }

.post-title {
  font-size:     clamp(1.75rem, 5vw, 2.75rem);
  margin-bottom: var(--sp-4);
  max-width:     760px;
}

.post-desc {
  font-size:     1rem;
  line-height:   1.7;
  max-width:     640px;
  margin-bottom: var(--sp-5);
}

.post-meta {
  display:     flex;
  align-items: center;
  flex-wrap:   wrap;
  gap:         var(--sp-2);
  font-size:   .8125rem;
}
.meta-sep { color: var(--txt-tertiary); }

/* Article content */
.post-body {
  padding: var(--sp-12) 0;
}

/* Back link */
.back-link {
  display:     inline-flex;
  align-items: center;
  gap:         var(--sp-2);
  margin-top:  var(--sp-12);
  font-size:   .875rem;
  font-weight: 600;
  color:       var(--clr-teal);
  min-height:  var(--touch);
  transition:  color .15s, gap .15s;
}
.back-link:hover { color: var(--clr-teal-2); gap: var(--sp-3); }
.back-link svg { width: 14px; height: 14px; }
</style>
