---
import BaseLayout from "./BaseLayout.astro";
import { peekEnv } from "../lib/db";
import { getSessionUser } from "../lib/auth/magic-link";
import {
  bidNumber, closeWeekdayChip, displayTitle, fmtCloseLong, fmtCloseTime,
  provinceLabel, urgency,
} from "../lib/tender-display";
import "../styles/tender-list.css";

export interface Props {
  title: string;
  description: string;
  hubType: "Province" | "Sector";
  hubName: string;
  contextLabel: string;
  filterSlug?: string;
  lastUpdated?: string;
}

const {
  title, description, hubType, hubName, contextLabel,
  filterSlug: rawFilterSlug,
  lastUpdated = new Date().toISOString().slice(0, 10),
} = Astro.props;

const filterSlug =
  rawFilterSlug ||
  hubName.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

let tenders: any[] = [];
let totalOpen = 0;
let authed = false;
let dbReady = true;

try {
  const env = peekEnv(Astro);
  if (!env?.DB) throw new Error('no db');
  let user: any = null;
  try { user = await getSessionUser(env.DB, Astro.request.headers.get("cookie")); } catch {}
  authed = !!user;

  const limit = authed ? 30 : 8;
  const filterCol = hubType === "Province" ? "province" : "sector";

  const result = await env.DB.prepare(
    `SELECT id, source_ref, title, description, procuring_entity, province, sector,
            closing_date, closing_time, briefing_compulsory, cidb_grade, estimated_value, bbbee_required
     FROM tenders
     WHERE status = 'open' AND canonical_ref IS NULL AND ${filterCol} = ?
       AND (closing_date IS NULL OR date(closing_date) >= date('now'))
     ORDER BY COALESCE(closing_date, '9999-12-31') ASC, first_seen_at DESC
     LIMIT ?`
  ).bind(filterSlug, limit).all();

  tenders = result.results || [];

  const total = await env.DB.prepare(
    `SELECT COUNT(*) AS n FROM tenders
     WHERE status = 'open' AND canonical_ref IS NULL AND ${filterCol} = ?
       AND (closing_date IS NULL OR date(closing_date) >= date('now'))`
  ).bind(filterSlug).first<{ n: number }>();
  totalOpen = total?.n || tenders.length;
} catch {
  dbReady = false;
}

const breadcrumbJsonLd = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://tenderpreneurs.co.za/" },
    { "@type": "ListItem", position: 2, name: "Tenders", item: "https://tenderpreneurs.co.za/tenders" },
    { "@type": "ListItem", position: 3, name: hubName, item: Astro.url.href },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  <div class="tenders-workspace">
    <div class="tenders-main">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/tenders">Tenders</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">{hubName}</li>
        </ol>
      </nav>
      <header class="tenders-hero">
        <div>
          <p class="lede" style="text-transform:uppercase;letter-spacing:.06em;font-size:12px">{hubType}</p>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          {totalOpen > 0 && (
            <p class="lede">{totalOpen.toLocaleString()} open now{!authed && totalOpen > tenders.length ? ' · showing the first page' : ''}</p>
          )}
        </div>
      </header>

      <section class="tender-list" aria-label={`Open tenders in ${hubName}`}>
        {tenders.length > 0 ? tenders.map((t) => {
          const u = urgency(t.closing_date, t.closing_time);
          const weekday = closeWeekdayChip(t.closing_date);
          const ref = bidNumber(t);
          return (
            <a href={`/tenders/t/${t.id}`} class="tender-row">
              <div class="tr-when">
                {ref && <p class="tr-ref">{ref}</p>}
                {t.closing_date && (
                  <>
                    <p class="tr-close-lbl">Closing</p>
                    <p class="tr-close-date">{fmtCloseLong(t.closing_date)}</p>
                    {t.closing_time && <p class="tr-close-time">{fmtCloseTime(t.closing_time)}</p>}
                  </>
                )}
              </div>
              <div class="tr-main">
                <h2 class="tender-title">{displayTitle(t)}</h2>
                <p class="tender-entity">{[t.procuring_entity, provinceLabel(t.province)].filter(Boolean).join(' · ')}</p>
                <div class="tender-tags">
                  {t.cidb_grade ? <span class="tag tag-cidb">CIDB {t.cidb_grade}</span> : null}
                  {weekday ? <span class={`tag tag-deadline ${u.cls}`}>{weekday}</span> : null}
                  {t.briefing_compulsory ? <span class="tag tag-brief">Compulsory briefing</span> : null}
                </div>
              </div>
            </a>
          );
        }) : (
          <p class="lede">{dbReady ? `No open ${contextLabel} tenders matched yet.` : 'Catalogue is catching up. Try the main list.'}</p>
        )}
      </section>

      {!authed && totalOpen > tenders.length && (
        <div class="gate-banner">
          <div class="gate-inner">
            <strong>Sign in to see every {hubName} tender</strong>
            <p>{(totalOpen - tenders.length).toLocaleString()} more are on the full catalogue.</p>
            <a class="btn-primary" href={`/auth/login?redirect_to=${Astro.url.pathname}`}>Sign in free</a>
          </div>
        </div>
      )}

      <article class="hub-copy">
        <slot />
      </article>
      <p class="lede" style="margin-top:28px">Last reviewed: {lastUpdated}.</p>
    </div>
  </div>
</BaseLayout>
<style>
  .hub-copy { margin-top: 36px; color: #3D4A5C; max-width: 68ch; }
  .hub-copy :global(h2) { color:#141820; font-size:1.25rem; margin:28px 0 10px; }
  .hub-copy :global(h3) { color:#141820; font-size:1.05rem; margin:20px 0 8px; }
  .hub-copy :global(a) { color:#A66708; }
</style>
